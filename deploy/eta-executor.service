[Unit]
Description=Aborigen ETA browser executor (separate host)
After=network-online.target
Wants=network-online.target
[Service]
User=eta-executor
Group=eta-executor
WorkingDirectory=/opt/aborigen-crm
EnvironmentFile=/etc/eta-executor.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/eta-venv/bin/python -m integrations.eta_executor.worker
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=eta-executor
StateDirectoryMode=0700
ReadWritePaths=/var/lib/eta-executor
[Install]
WantedBy=multi-user.target
