# Copy to /etc/aborigen-crm-backup.env; root:root 0600.
# Configure the rclone remote interactively on the server; do not send passwords in chat.
RESTIC_REPOSITORY=rclone:masterhost:crm-backups
RESTIC_PASSWORD_FILE=/root/.config/aborigen-crm/restic-password
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
