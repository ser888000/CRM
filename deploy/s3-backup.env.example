# Copy to /etc/aborigen-crm-backup.env, root:root 0600.
# Create a private bucket at a provider separate from the CRM VPS.
RESTIC_REPOSITORY=s3:https://S3_ENDPOINT/BUCKET/aborigen-crm
RESTIC_PASSWORD_FILE=/root/.config/aborigen-crm/restic-password
AWS_ACCESS_KEY_ID=SET_ON_SERVER
AWS_SECRET_ACCESS_KEY=SET_ON_SERVER
AWS_DEFAULT_REGION=SET_PROVIDER_REGION
