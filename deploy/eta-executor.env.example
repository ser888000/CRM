# /etc/eta-executor.env: root-owned 0600, never commit a completed file.
ETA_CRM_URL=https://crm.aborigen-tour.ru
ETA_WORKER_ID=eta-worker-1
ETA_WORKER_TOKEN=
ETA_PORTAL_MAP=/etc/eta-executor/portal-map.json
ETA_STATE_DIR=/var/lib/eta-executor
ETA_HEADLESS=1
ETA_MAX_SESSIONS=3
# Keep 0 until verified on the current official portal, including final button semantics.
ETA_ALLOW_SUBMIT=0
