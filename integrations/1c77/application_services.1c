// Штатная форма заявки создаёт такой служебный документ даже без строк услуг.
// Он также нужен логике 1С при закрытии единственной путёвки.
// Вызывать внутри транзакции основной операции.
Функция crmEnsureApplicationServices(crmApplication)
    crmServicesSearch=СоздатьОбъект("Документ");
    crmServicesSearch.ВыбратьПодчиненныеДокументы(,,crmApplication);
    crmServicesCount=0; crmServicesDeleted=0;
    Пока crmServicesSearch.ПолучитьДокумент()=1 Цикл
        Если crmServicesSearch.Вид()="УслугиПоЗаявке" Тогда
            crmServicesCount=crmServicesCount+1;
            Если crmServicesSearch.ПометкаУдаления()=1 Тогда crmServicesDeleted=1; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если (crmServicesCount>1) Или (crmServicesDeleted=1) Тогда
        Предупреждение("Проверьте связанные Услуги по заявке: есть дубли или пометка удаления. Автоматически не изменяются.");
        Возврат 0;
    КонецЕсли;
    Если crmServicesCount=1 Тогда Возврат 1; КонецЕсли;
    crmServicesParent=СоздатьОбъект("Документ.Заявка");
    crmServicesParent.НайтиДокумент(crmApplication);
    Если crmServicesParent.ПометкаУдаления()=1 Тогда Возврат 0; КонецЕсли;
    crmServicesDoc=СоздатьОбъект("Документ.УслугиПоЗаявке");
    crmServicesDoc.Новый(); crmServicesDoc.ДатаДок=crmServicesParent.ДатаДок;
    crmServicesDoc.УстановитьНовыйНомер();
    crmServicesDoc.Заявка=crmApplication;
    crmServicesDoc.Валюта=crmServicesParent.Валюта; crmServicesDoc.Курс=crmServicesParent.Курс;
    crmServicesDoc.Записать();
    crmServicesCheck=СоздатьОбъект("Документ.УслугиПоЗаявке");
    crmServicesCheck.НайтиДокумент(crmServicesDoc.ТекущийДокумент());
    Если (crmServicesCheck.Заявка<>crmApplication) Или (crmServicesCheck.КоличествоСтрок()<>0) Тогда Возврат 0; КонецЕсли;
    Сообщить("CRM: добавлен штатный служебный документ Услуги по заявке без строк и проводок.");
    Возврат 1;
КонецФункции

// Основания возвратов: существующий Основной договор либо новый комиссионный.
Функция crmFindMainAgreement(crmOwner)
    crmRef=СоздатьОбъект("Справочник.Договоры"); crmRef.ИспользоватьВладельца(crmOwner); crmRef.ВыбратьЭлементы();
    crmCount=0; crmFound="";
    Пока crmRef.ПолучитьЭлемент()=1 Цикл
        Если (crmRef.ЭтоГруппа()=0) И (crmRef.ПометкаУдаления()=0) И (НРег(СокрЛП(crmRef.Наименование))="основной договор") Тогда
            crmCount=crmCount+1; crmFound=crmRef.ТекущийЭлемент();
        КонецЕсли;
    КонецЦикла;
    Если crmCount>1 Тогда Предупреждение("Для "+Строка(crmOwner)+" несколько Основных договоров. Нужен ручной выбор основания."); Возврат -1; КонецЕсли;
    Возврат crmFound;
КонецФункции

Функция crmMainAgreement(crmOwner)
    crmFound=crmFindMainAgreement(crmOwner);
    Если ПустоеЗначение(crmFound)=0 Тогда Возврат crmFound; КонецЕсли;
    crmOwnTransaction=?(crmTransaction=1,0,1);
    Если crmOwnTransaction=1 Тогда НачатьТранзакцию(); КонецЕсли;
    Попытка
        // Повторный поиск в транзакции перед созданием.
        crmFound=crmFindMainAgreement(crmOwner);
        Если ПустоеЗначение(crmFound)=0 Тогда
            Если crmOwnTransaction=1 Тогда ОтменитьТранзакцию(); КонецЕсли;
            Возврат crmFound;
        КонецЕсли;
        crmRef=СоздатьОбъект("Справочник.Договоры"); crmRef.ИспользоватьВладельца(crmOwner);
        crmRef.Новый(); crmRef.Наименование="Основной договор";
        crmRef.Комиссия=1; crmRef.ОплатаДоговора=1; crmRef.Записать();
        crmFound=crmRef.ТекущийЭлемент(); crmRef.НайтиЭлемент(crmFound);
        Если (crmRef.Владелец<>crmOwner) Или (crmRef.ПометкаУдаления()=1) Или (crmRef.Комиссия<>1) Тогда
            Если crmOwnTransaction=1 Тогда ОтменитьТранзакцию(); КонецЕсли;
            Предупреждение("Не прошла проверка нового Основного договора."); Возврат -1;
        КонецЕсли;
        Если crmOwnTransaction=1 Тогда ЗафиксироватьТранзакцию(); КонецЕсли;
        Сообщить("CRM: создан Основной договор для "+Строка(crmOwner)+". При необходимости замените его в проводках сторно.");
        Возврат crmFound;
    Исключение
        Если crmOwnTransaction=1 Тогда ОтменитьТранзакцию(); КонецЕсли;
        Предупреждение("Не удалось создать Основной договор: "+ОписаниеОшибки()); Возврат -1;
    КонецПопытки;
КонецФункции

Функция crmReturnParties(crmNode,crmCustomer,crmAgreement)
    crmCustomerNode=crmNode.ВыбратьУзел("CUSTOMER");
    crmName=НРег(СокрЛП(crmCustomerNode.ПолучитьАтрибут("NAME")));
    Пока Найти(crmName,"  ")>0 Цикл crmName=СтрЗаменить(crmName,"  "," "); КонецЦикла;
    crmRef=СоздатьОбъект("Справочник.Контрагенты"); crmRef.ВыбратьЭлементы(); crmCount=0;
    Пока crmRef.ПолучитьЭлемент()=1 Цикл
        Если (crmRef.ЭтоГруппа()=1) Или (crmRef.ПометкаУдаления()=1) Тогда Продолжить; КонецЕсли;
        crmText=crmRef.ПолнНаименование; Если ПустаяСтрока(СокрЛП(crmText))=1 Тогда crmText=crmRef.Наименование; КонецЕсли;
        crmText=НРег(СокрЛП(crmText)); Пока Найти(crmText,"  ")>0 Цикл crmText=СтрЗаменить(crmText,"  "," "); КонецЦикла;
        Если crmText=crmName Тогда crmCustomer=crmRef.ТекущийЭлемент(); crmCount=crmCount+1; КонецЕсли;
    КонецЦикла;
    Если crmCount<>1 Тогда
        Если crmRef.Выбрать("Выберите заказчика возврата: "+crmCustomerNode.ПолучитьАтрибут("NAME"),)=0 Тогда Возврат 0; КонецЕсли;
        Если (crmRef.ЭтоГруппа()=1) Или (crmRef.ПометкаУдаления()=1) Тогда Возврат 0; КонецЕсли;
        crmCustomer=crmRef.ТекущийЭлемент();
    КонецЕсли;
    crmAgreement=crmMainAgreement(crmCustomer);
    Если ТипЗначенияСтр(crmAgreement)="Число" Тогда Возврат 0; КонецЕсли;
    Возврат 1;
КонецФункции
