// Первый этап приёмника: одна новая непроведённая заявка в тестовой копии.
// Произвольные существующие документы не изменяет. Платежи не загружает.
Перем Connection,тзТипыКонтрагентов,тзМенеджеры,НадписьИнф,ГруппаCRM;
Перем crmTransaction,crmStage;

Функция crmName(crmText)
    // Параметры 7.7 передаются по ссылке: изменяем только локальную копию.
    crmNormalized=НРег(СокрЛП(СтрЗаменить(crmText," "," ")));
    Пока Найти(crmNormalized,"  ")>0 Цикл
        crmNormalized=СтрЗаменить(crmNormalized,"  "," ");
    КонецЦикла;
    Возврат crmNormalized;
КонецФункции

Функция crmUUID(crmText)
    Если СтрДлина(crmText)<>36 Тогда Возврат 0; КонецЕсли;
    Для crmN=1 По 36 Цикл
        crmChar=Сред(crmText,crmN,1);
        Если (crmN=9) Или (crmN=14) Или (crmN=19) Или (crmN=24) Тогда
            Если crmChar<>"-" Тогда Возврат 0; КонецЕсли;
        Иначе
            Если Найти("0123456789abcdef",crmChar)=0 Тогда Возврат 0; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Возврат ?(crmText="00000000-0000-0000-0000-000000000000",0,1);
КонецФункции

Функция crmError(crmValue)
    Если ТипЗначенияСтр(crmValue)="Число" Тогда
        Возврат ?(crmValue=-1,1,0);
    КонецЕсли;
    Возврат 0;
КонецФункции

Функция crmExisting(crmID)
    crmSearch=СоздатьОбъект("Документ");
    crmSearch.ВыбратьПоЗначению(,,"Идентификатор",crmID);
    crmFound=""; crmCount=0;
    Пока crmSearch.ПолучитьДокумент()=1 Цикл
        Если crmSearch.Вид()="Заявка" Тогда
            Если СокрЛП(crmSearch.Идентификатор)=crmID Тогда
                crmCount=crmCount+1;
                crmFound=crmSearch.ТекущийДокумент();
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если crmCount>1 Тогда
        Предупреждение("Найдено несколько заявок с одним ключом CRM. Нужна ручная проверка.");
        Возврат -1;
    КонецЕсли;
    Возврат crmFound;
КонецФункции

Функция crmReference(crmKind,crmText,crmForceChoice)
    crmRef=СоздатьОбъект("Справочник."+crmKind);
    crmRef.ВыбратьЭлементы();
    crmCount=0; crmFound="";
    Пока crmRef.ПолучитьЭлемент()=1 Цикл
        Если (crmRef.ЭтоГруппа()=0) И (crmRef.ПометкаУдаления()=0) Тогда
            crmCompare=crmRef.Наименование;
            Если crmKind="Контрагенты" Тогда
                Если ПустаяСтрока(СокрЛП(crmRef.ПолнНаименование))=0 Тогда crmCompare=crmRef.ПолнНаименование; КонецЕсли;
            КонецЕсли;
            Если crmName(crmCompare)=crmName(crmText) Тогда
                crmFound=crmRef.ТекущийЭлемент(); crmCount=crmCount+1;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если crmCount=1 Тогда Возврат crmFound; КонецЕсли;
    Если (crmCount>1) Или (crmForceChoice=1) Тогда
        Если crmRef.Выбрать("Выберите: "+crmText,)=0 Тогда Возврат -1; КонецЕсли;
        Если (crmRef.ЭтоГруппа()=1) Или (crmRef.ПометкаУдаления()=1) Тогда
            Предупреждение("Выберите действующий элемент, а не группу."); Возврат -1;
        КонецЕсли;
        Возврат crmRef.ТекущийЭлемент();
    КонецЕсли;
    Если (crmKind<>"Контрагенты") И (СтрДлина(crmText)>Метаданные.Справочник(crmKind).ДлинаНаименования) Тогда
        Предупреждение("ФИО длиннее допустимого в справочнике "+crmKind+". Автоматически сокращать его не будем.");
        Возврат -1;
    КонецЕсли;
    Возврат "";
КонецФункции

// Соответствия хранятся в настройках 1С для пользователя и этой базы.
Функция crmOperatorMapping(crmOperatorID,crmOperatorName)
    crmKey="AborigenCRM_TO_V1_"+НРег(КаталогИБ())+"_"+crmOperatorID;
    crmStored="";
    Попытка
        crmStored=ВосстановитьЗначение(crmKey);
        Если ТипЗначения(crmStored)=11 Тогда
            crmMapped=СоздатьОбъект("Справочник.Контрагенты");
            crmMapped.НайтиЭлемент(crmStored);
            Если (crmMapped.Выбран()=1) И (crmMapped.ЭтоГруппа()=0) И (crmMapped.ПометкаУдаления()=0) Тогда
                Сообщить("CRM: ТО "+crmOperatorName+" -> "+Строка(crmStored)+" (сохранённое соответствие).");
                Возврат crmStored;
            КонецЕсли;
        КонецЕсли;
    Исключение
        // Отсутствующая или устаревшая ссылка требует нового выбора.
        crmStored="";
    КонецПопытки;
    crmMapped=СоздатьОбъект("Справочник.Контрагенты");
    Если crmMapped.Выбрать("ТО CRM: "+crmOperatorName+" — выберите ЮЛ в 1С",)=0 Тогда Возврат -1; КонецЕсли;
    Если (crmMapped.ЭтоГруппа()=1) Или (crmMapped.ПометкаУдаления()=1) Тогда
        Предупреждение("Выберите действующего контрагента, а не группу."); Возврат -1;
    КонецЕсли;
    crmSelected=crmMapped.ТекущийЭлемент();
    СохранитьЗначение(crmKey,crmSelected);
    crmStored=ВосстановитьЗначение(crmKey);
    Если ТипЗначения(crmStored)<>11 Тогда
        Предупреждение("Не удалось сохранить соответствие ТО в настройках 1С."); Возврат -1;
    КонецЕсли;
    Если crmStored<>crmSelected Тогда
        Предупреждение("Не прошла проверка сохранённого соответствия ТО."); Возврат -1;
    КонецЕсли;
    Сообщить("CRM: запомнено соответствие ТО "+crmOperatorName+" -> "+Строка(crmSelected));
    Возврат crmSelected;
КонецФункции

Функция crmFixedTour()
    crmTours=СоздатьОбъект("Справочник.Туры");
    crmTours.ВыбратьЭлементы();
    crmCount=0; crmFound="";
    Пока crmTours.ПолучитьЭлемент()=1 Цикл
        Если (crmTours.ЭтоГруппа()=0) И (crmTours.ПометкаУдаления()=0) Тогда
            crmCode=СокрЛП(Строка(crmTours.Код));
            Пока (СтрДлина(crmCode)>1) И (Лев(crmCode,1)="0") Цикл
                crmCode=Сред(crmCode,2);
            КонецЦикла;
            Если crmCode="319" Тогда
                crmFound=crmTours.ТекущийЭлемент(); crmCount=crmCount+1;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если crmCount<>1 Тогда
        Предупреждение("Не найден единственный действующий тур с кодом 319. Заявка не создана."); Возврат -1;
    КонецЕсли;
    Возврат crmFound;
КонецФункции

Функция crmAgreementTitle(crmDoc)
    Возврат "Заявка №"+глПреобразоватьНомерДок(crmDoc.НомерДок)+" от "+Формат(crmDoc.ДатаДок,"Д ДД.ММ.ГГ");
КонецФункции

Функция crmCheckAgreementTitle(crmAgreementRef,crmOwner,crmLegacyTitle,crmTitle)
    Если ПустоеЗначение(crmAgreementRef)=1 Тогда Возврат 0; КонецЕсли;
    crmRef=СоздатьОбъект("Справочник.Договоры"); crmRef.НайтиЭлемент(crmAgreementRef);
    Если crmRef.Выбран()=0 Тогда Предупреждение("Не найден договор расчётов."); Возврат -1; КонецЕсли;
    // Переименовываем только собственные старые названия, не пользовательские.
    Если СокрЛП(crmRef.Наименование)<>crmLegacyTitle Тогда Возврат 0; КонецЕсли;
    Если (crmRef.Владелец<>crmOwner) Или (crmRef.ПометкаУдаления()=1) Тогда
        Предупреждение("Не совпал владелец договора расчётов или он помечен на удаление."); Возврат -1;
    КонецЕсли;
    Если СтрДлина(crmTitle)>Метаданные.Справочник("Договоры").ДлинаНаименования Тогда
        Предупреждение("Название договора расчётов длиннее допустимого."); Возврат -1;
    КонецЕсли;
    // Название не является ключом: совпадение не требует объединения.
    // Меняем только текущий элемент, сохраняя его внутреннюю ссылку.
    Возврат 1;
КонецФункции

Функция crmRenameAgreementTitles(crmApplication,crmID)
    crmParent=СоздатьОбъект("Документ.Заявка"); crmParent.НайтиДокумент(crmApplication);
    Если (СокрЛП(crmParent.Идентификатор)<>crmID) Или (Найти(crmParent.Примечания,"Ключ CRM: "+crmID)=0) Тогда
        Предупреждение("Для изменения названий нужна служебная метка нашей импортированной заявки."); Возврат 0;
    КонецЕсли;
    crmTitle=crmAgreementTitle(crmParent); crmLegacyTitle="CRM "+crmID;
    crmReferences=СоздатьОбъект("СписокЗначений"); crmOwners=СоздатьОбъект("СписокЗначений");
    crmReferences.ДобавитьЗначение(crmParent.ДоговорПлательщика); crmReferences.ДобавитьЗначение(crmParent.ДоговорОператора);
    crmOwners.ДобавитьЗначение(crmParent.Плательщик); crmOwners.ДобавитьЗначение(crmParent.ТурОператор);
    crmChanges=СоздатьОбъект("СписокЗначений"); crmChangeOwners=СоздатьОбъект("СписокЗначений");
    Для crmN=1 По 2 Цикл
        crmAgreementRef=crmReferences.ПолучитьЗначение(crmN); crmOwner=crmOwners.ПолучитьЗначение(crmN);
        crmState=crmCheckAgreementTitle(crmAgreementRef,crmOwner,crmLegacyTitle,crmTitle);
        Если crmState=-1 Тогда Возврат 0; КонецЕсли;
        Если crmState=1 Тогда
            Если crmChanges.НайтиЗначение(crmAgreementRef)=0 Тогда
                crmChanges.ДобавитьЗначение(crmAgreementRef); crmChangeOwners.ДобавитьЗначение(crmOwner);
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если crmChanges.РазмерСписка()=0 Тогда
        Сообщить("CRM: названия оснований уже читаемые или заданы вручную, не изменялись."); Возврат 1;
    КонецЕсли;
    crmPrompt="Заявка уже существует. Переименовать основания CRM с длинным кодом в "+crmTitle+"?"+РазделительСтрок;
    crmPrompt=crmPrompt+"Изменится только название договоров расчётов. Совпадающие названия допустимы: записи не объединяются. Ссылки, суммы, проводки и ключ заявки сохраняются.";
    Если Вопрос(crmPrompt,4)<>6 Тогда Возврат 0; КонецЕсли;
    crmStage="Читаемые названия оснований";
    НачатьТранзакцию(); crmTransaction=1;
    crmParent.НайтиДокумент(crmApplication);
    Если (crmAgreementTitle(crmParent)<>crmTitle) Или (СокрЛП(crmParent.Идентификатор)<>crmID) Или (crmParent.ДоговорПлательщика<>crmReferences.ПолучитьЗначение(1)) Или (crmParent.ДоговорОператора<>crmReferences.ПолучитьЗначение(2)) Тогда
        ОтменитьТранзакцию(); crmTransaction=0;
        Предупреждение("Заявка или её основания изменились. Переименование отменено."); Возврат 0;
    КонецЕсли;
    Для crmN=1 По crmChanges.РазмерСписка() Цикл
        crmAgreementRef=crmChanges.ПолучитьЗначение(crmN); crmOwner=crmChangeOwners.ПолучитьЗначение(crmN);
        Если crmCheckAgreementTitle(crmAgreementRef,crmOwner,crmLegacyTitle,crmTitle)<>1 Тогда
            ОтменитьТранзакцию(); crmTransaction=0;
            Предупреждение("Договор расчётов изменился. Переименование отменено."); Возврат 0;
        КонецЕсли;
        crmRef=СоздатьОбъект("Справочник.Договоры"); crmRef.НайтиЭлемент(crmAgreementRef);
        crmRef.Наименование=crmTitle; crmRef.Записать(); crmRef.НайтиЭлемент(crmAgreementRef);
        Если (СокрЛП(crmRef.Наименование)<>crmTitle) Или (crmRef.Владелец<>crmOwner) Тогда
            ОтменитьТранзакцию(); crmTransaction=0;
            Предупреждение("Не прошла проверка нового названия. Изменения отменены."); Возврат 0;
        КонецЕсли;
    КонецЦикла;
    ЗафиксироватьТранзакцию(); crmTransaction=0;
    Сообщить("CRM: основания переименованы в "+crmTitle+". Документы и проводки не перепроводились, ссылки не менялись.");
    Возврат 1;
КонецФункции

Функция crmAgreement(crmOwner,crmID,crmTitle)
    crmRef=СоздатьОбъект("Справочник.Договоры"); crmRef.ИспользоватьВладельца(crmOwner);
    crmLegacyTitle="CRM "+crmID;
    Если crmRef.НайтиПоНаименованию(crmLegacyTitle,0)=1 Тогда
        crmAgreementRef=crmRef.ТекущийЭлемент();
        Если crmCheckAgreementTitle(crmAgreementRef,crmOwner,crmLegacyTitle,crmTitle)<>1 Тогда Возврат -1; КонецЕсли;
        crmRef.Наименование=crmTitle; crmRef.Записать();
        Возврат crmRef.ТекущийЭлемент();
    КонецЕсли;
    Если crmRef.НайтиПоНаименованию(crmTitle,0)=1 Тогда
        Если crmRef.ПометкаУдаления()=1 Тогда Предупреждение("Договор расчётов помечен на удаление."); Возврат -1; КонецЕсли;
        Возврат crmRef.ТекущийЭлемент();
    КонецЕсли;
    Если СтрДлина(crmTitle)>Метаданные.Справочник("Договоры").ДлинаНаименования Тогда
        Предупреждение("Название договора расчётов длиннее допустимого."); Возврат -1;
    КонецЕсли;
    crmRef.Новый(); crmRef.Наименование=crmTitle;
    crmRef.Комиссия=1; crmRef.ОплатаДоговора=1;
    crmRef.Записать();
    Возврат crmRef.ТекущийЭлемент();
КонецФункции

Процедура crmImport(crmBatch=0,crmBatchRoot="",crmBatchIndex=0,crmResult="")
    crmResult="failed";
    Если crmBatch=1 Тогда
        // Обрабатываем уже прочитанный и подтверждённый пакет, не перечитываем файл.
        crmRoot=crmBatchRoot;
    Иначе
        Если ЗагрузитьВнешнююКомпоненту("V7plus.dll")<>1 Тогда
            Предупреждение("Не найдена V7Plus.dll."); Возврат;
        КонецЕсли;
        crmXML=СоздатьОбъект("AddIn.XMLParser");
        Если Число(crmXML.ВерсияАнализатора)<2 Тогда
            Предупреждение("Нужен XMLParser не ниже 2.0."); Возврат;
        КонецЕсли;
        crmFile=""; crmDir="";
        Если ФС.ВыбратьФайл(0,crmFile,crmDir,"Выберите exchange.xml из CRM","Пакет CRM (*.xml)|*.xml","xml",)<>1 Тогда Возврат; КонецЕсли;
        crmXMLDoc=crmXML.СоздатьДокумент();
        crmStage="Чтение XML";
        crmXMLDoc.Загрузить(crmDir+crmFile);
        crmRoot=crmXMLDoc.ЭлементДокумента;
    КонецЕсли;
    Если crmRoot.Наименование<>"CRM_TEST_EXPORT" Тогда
        Предупреждение("Это не пакет CRM."); Возврат;
    КонецЕсли;
    Если (crmRoot.ПолучитьАтрибут("VERSION")<>"1") Или (crmRoot.ПолучитьАтрибут("TEST_ONLY")<>"1") Тогда
        Предупреждение("Версия пакета не поддерживается."); Возврат;
    КонецЕсли;
    crmNodes=crmRoot.ВыбратьУзлы("CONTRACT");
    Если crmNodes.КоличествоУзлов<1 Тогда
        Предупреждение("В пакете нет договоров."); Возврат;
    КонецЕсли;
    Если crmBatch=1 Тогда
        Если (crmBatchIndex<0) Или (crmBatchIndex>=crmNodes.КоличествоУзлов) Тогда Возврат; КонецЕсли;
        crmChoice=crmBatchIndex;
    Иначе
    crmList=СоздатьОбъект("СписокЗначений");
    Для crmN=0 По crmNodes.КоличествоУзлов-1 Цикл
        crmNode=crmNodes.ПолучитьУзел(crmN);
        crmList.ДобавитьЗначение(crmN,"Договор "+crmNode.ПолучитьАтрибут("NUMBER")+" от "+crmNode.ПолучитьАтрибут("DATE"));
    КонецЦикла;
    crmChoice=0; crmPosition=1;
        Если crmList.ВыбратьЗначение(crmChoice,"Одну заявку для загрузки в тестовую копию",crmPosition,,1)=0 Тогда Возврат; КонецЕсли;
    КонецЕсли;
    crmNode=crmNodes.ПолучитьУзел(crmChoice);
    crmID=crmNode.ПолучитьАтрибут("ID");
    Если crmUUID(crmID)=0 Тогда Предупреждение("Некорректный ключ CRM."); Возврат; КонецЕсли;
    crmStage="Поиск заявки по ключу CRM";
    crmFound=crmExisting(crmID);
    Если crmError(crmFound)=1 Тогда Возврат; КонецЕсли;
    Если ПустоеЗначение(crmFound)=0 Тогда
        Если crmBatch=0 Тогда
            Если crmRenameAgreementTitles(crmFound,crmID)=0 Тогда Возврат; КонецЕсли;
        КонецЕсли;
        crmResult="existing";
        Сообщить("CRM: заявка уже существует: "+Строка(crmFound)+". Новая не создана, денежные документы не изменялись.");
        Возврат;
    КонецЕсли;
    crmCustomerNode=crmNode.ВыбратьУзел("CUSTOMER");
    crmOperatorNode=crmNode.ВыбратьУзел("OPERATOR");
    crmRows=crmNode.ВыбратьУзлы("ROW");
    Если crmRows.КоличествоУзлов<>1 Тогда Предупреждение("Нужна одна строка заказчика."); Возврат; КонецЕсли;
    crmCustomerName=СокрЛП(crmCustomerNode.ПолучитьАтрибут("NAME"));
    crmOperatorName=СокрЛП(crmOperatorNode.ПолучитьАтрибут("NAME"));
    crmCustomerID=crmCustomerNode.ПолучитьАтрибут("ID");
    crmOperatorID=crmOperatorNode.ПолучитьАтрибут("ID");
    Если crmUUID(crmOperatorID)=0 Тогда Предупреждение("Некорректный ключ ТО из CRM."); Возврат; КонецЕсли;
    Если (ПустаяСтрока(crmCustomerName)=1) Или (ПустаяСтрока(crmOperatorName)=1) Или (crmUUID(crmCustomerID)=0) Тогда
        Предупреждение("Не заполнены заказчик, ТО или ключ заказчика."); Возврат;
    КонецЕсли;
    crmDateText=crmNode.ПолучитьАтрибут("DATE");
    Если СтрДлина(crmDateText)<>10 Тогда Предупреждение("Некорректная дата."); Возврат; КонецЕсли;
    crmDate=Дата(Прав(crmDateText,2)+"."+Сред(crmDateText,6,2)+"."+Лев(crmDateText,4));
    Если ДатаГод(crmDate)<>2026 Тогда
        Предупреждение("Первый тест создаёт только заявки 2026 года. Старые годы не загружаются."); Возврат;
    КонецЕсли;
    crmAmount=Число(crmNode.ПолучитьАтрибут("AMOUNT"));
    crmCost=Число(crmNode.ПолучитьАтрибут("COST"));
    crmCommission=Число(crmNode.ПолучитьАтрибут("COMMISSION"));
    crmRow=crmRows.ПолучитьУзел(0);
    Если (crmNode.ПолучитьАтрибут("CURRENCY")<>"RUB") Или (crmAmount<=0) Или (crmCost<0) Тогда
        Предупреждение("Проверьте рублёвую сумму и себестоимость."); Возврат;
    КонецЕсли;
    Если crmCost>crmAmount Тогда
        Предупреждение("Себестоимость выше суммы договора. Такой случай пока оставляем для отдельной проверки."); Возврат;
    КонецЕсли;
    Если (crmAmount-crmCost<>crmCommission) Или (Число(crmRow.ПолучитьАтрибут("AMOUNT"))<>crmAmount) Или (Число(crmRow.ПолучитьАтрибут("COST"))<>crmCost) Или (crmRow.ПолучитьАтрибут("CUSTOMER")<>crmCustomerID) Тогда
        Предупреждение("Не сошлись суммы или связь единственной строки с заказчиком."); Возврат;
    КонецЕсли;
    crmStage="Выбор заказчика";
    crmCustomer=crmReference("Контрагенты",crmCustomerName,0);
    Если crmError(crmCustomer)=1 Тогда Возврат; КонецЕсли;
    crmStage="Тур с кодом 319";
    crmTour=crmFixedTour();
    Если crmError(crmTour)=1 Тогда Возврат; КонецЕсли;
    crmStage="Соответствие ТО";
    crmOperator=crmOperatorMapping(crmOperatorID,crmOperatorName);
    Если crmError(crmOperator)=1 Тогда Возврат; КонецЕсли;
    // ТО определяется соответствием CRM, не реквизитами служебного тура 319.
    crmStage="Строка заказчика";
    crmTourist=crmReference("Туристы",crmCustomerName,0);
    Если crmError(crmTourist)=1 Тогда Возврат; КонецЕсли;
    crmStage="Рублёвая валюта";
    crmRub=Рубль;
    Если ПустоеЗначение(crmRub)=1 Тогда Предупреждение("Не определена рублёвая валюта 1С."); Возврат; КонецЕсли;
    crmPrompt="Создать одну НЕПРОВЕДЁННУЮ заявку в открытой тестовой базе?"+РазделительСтрок;
    crmPrompt=crmPrompt+"Договор CRM "+crmNode.ПолучитьАтрибут("NUMBER")+" от "+crmDateText+РазделительСтрок;
    crmPrompt=crmPrompt+"Заказчик: "+?(ПустоеЗначение(crmCustomer)=1,crmCustomerName,Строка(crmCustomer))+РазделительСтрок;
    crmPrompt=crmPrompt+"Тур: "+Строка(crmTour)+РазделительСтрок;
    crmPrompt=crmPrompt+"ТО: "+Строка(crmOperator)+"; сумма: "+Строка(crmAmount)+"; себестоимость: "+Строка(crmCost);
    Если crmBatch=0 Тогда
        Если Вопрос(crmPrompt,4)<>6 Тогда Возврат; КонецЕсли;
    КонецЕсли;
    crmStage="Начало сохранения";
    НачатьТранзакцию(); crmTransaction=1;
    crmStage="Поиск заявки по ключу CRM";
    crmFound=crmExisting(crmID);
    Если ПустоеЗначение(crmFound)=0 Тогда
        ОтменитьТранзакцию(); crmTransaction=0;
        Сообщить("CRM: повторный ключ. Создание отменено."); Возврат;
    КонецЕсли;
    crmStage="Создание заказчика";
    Если ПустоеЗначение(crmCustomer)=1 Тогда
        crmRef=СоздатьОбъект("Справочник.Контрагенты");
        crmRef.Новый(); crmRef.Наименование=Лев(crmCustomerName,Метаданные.Справочник("Контрагенты").ДлинаНаименования);
        crmRef.ПолнНаименование=crmCustomerName;
        crmRef.ВидКонтрагента=Перечисление.ВидыКонтрагентов.ЧастноеЛицо;
        crmRef.Идентификатор=crmCustomerID;
        crmRef.Записать(); crmCustomer=crmRef.ТекущийЭлемент();
    КонецЕсли;
    crmStage="Создание строки заказчика";
    Если ПустоеЗначение(crmTourist)=1 Тогда
        crmRef=СоздатьОбъект("Справочник.Туристы");
        crmRef.Новый(); crmRef.Наименование=crmCustomerName;
        crmRef.Плательщик=crmCustomer;
        crmRef.Записать(); crmTourist=crmRef.ТекущийЭлемент();
    КонецЕсли;
    crmStage="Заполнение заявки";
    crmDoc=СоздатьОбъект("Документ.Заявка");
    crmDoc.Новый(); crmDoc.ДатаДок=crmDate;
    crmDoc.УстановитьНовыйНомер(); crmDoc.Идентификатор=crmID;
    crmDoc.Плательщик=crmCustomer; crmDoc.ТурОператор=crmOperator;
    crmDoc.Тур=crmTour; crmDoc.Направление=crmTour.Направление;
    crmStage="Договоры расчётов";
    crmTitle=crmAgreementTitle(crmDoc);
    crmPayAgreement=crmAgreement(crmCustomer,crmID,crmTitle);
    Если crmError(crmPayAgreement)=1 Тогда ОтменитьТранзакцию(); crmTransaction=0; Возврат; КонецЕсли;
    crmOperatorAgreement=crmAgreement(crmOperator,crmID,crmTitle);
    Если crmError(crmOperatorAgreement)=1 Тогда ОтменитьТранзакцию(); crmTransaction=0; Возврат; КонецЕсли;
    crmDoc.ДоговорПлательщика=crmPayAgreement;
    crmDoc.ДоговорОператора=crmOperatorAgreement;
    crmDoc.Валюта=crmRub; crmDoc.Курс=1;
    crmDoc.Статус=Перечисление.СтатусыЗаявок.Введена;
    crmDoc.Примечания="Договор CRM №"+crmNode.ПолучитьАтрибут("NUMBER")+" от "+crmDateText+РазделительСтрок+"Ключ CRM: "+crmID;
    crmDoc.НоваяСтрока(); crmDoc.Турист=crmTourist;
    crmDoc.Сумма=crmAmount; crmDoc.Себестоимость=crmCost; crmDoc.СуммаСкидки=0;
    crmDoc.ИтогоСумма=crmAmount; crmDoc.ИтогоСебестоимость=crmCost;
    crmDoc.ИтогоСуммаСкидки=0; crmDoc.ИтогоКомиссия=crmCommission;
    crmStage="Сохранение заявки";
    crmDoc.Записать();
    crmSaved=crmDoc.ТекущийДокумент();
    crmStage="Служебные услуги заявки";
    Если crmEnsureApplicationServices(crmSaved)=0 Тогда
        ОтменитьТранзакцию(); crmTransaction=0;
        Предупреждение("Не удалось подготовить штатные услуги заявки. Создание отменено."); Возврат;
    КонецЕсли;
    crmStage="Проверка сохранённой заявки";
    crmCheck=СоздатьОбъект("Документ.Заявка");
    crmCheck.НайтиДокумент(crmSaved);
    Если (crmCheck.Проведен()<>0) Или (СокрЛП(crmCheck.Идентификатор)<>crmID) Или (crmCheck.ИтогоСумма<>crmAmount) Или (crmCheck.ИтогоСебестоимость<>crmCost) Или (crmCheck.ТурОператор<>crmOperator) Или (crmCheck.Тур<>crmTour) Тогда
        ОтменитьТранзакцию(); crmTransaction=0;
        Предупреждение("Не прошла проверка сохранённых данных. Создание отменено."); Возврат;
    КонецЕсли;
    ЗафиксироватьТранзакцию(); crmTransaction=0; crmResult="created";
    Сообщить("CRM: создана одна непроведённая заявка: "+Строка(crmSaved));
    Сообщить("Договор CRM: "+crmNode.ПолучитьАтрибут("NUMBER")+"; ключ: "+crmID);
    Сообщить("Сумма: "+Строка(crmAmount)+"; себестоимость: "+Строка(crmCost)+"; комиссия: "+Строка(crmCommission));
    Сообщить("Путёвка, отгрузка и платежи на этом этапе не создаются. Повторите загрузку этого же договора для проверки отсутствия дубля.");
    crmStage="Открытие сохранённой заявки";
    Если crmBatch=0 Тогда ОткрытьФорму(crmSaved); КонецЕсли;
КонецПроцедуры

Процедура ПриОткрытии()
    crmTransaction=0; crmStage="Запуск";
    Попытка
        crmImport();
    Исключение
        Если crmTransaction=1 Тогда ОтменитьТранзакцию(); crmTransaction=0; КонецЕсли;
        Предупреждение("Заявка CRM ("+crmStage+"): "+ОписаниеОшибки());
    КонецПопытки;
    СтатусВозврата(0);
КонецПроцедуры
