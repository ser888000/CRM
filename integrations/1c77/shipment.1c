// Первый тест отгрузки: одна существующая заявка и проведённая путёвка.
// Штатное проведение 1С. Полная комиссия, без изменения старых документов.
Перем Connection,тзТипыКонтрагентов,тзМенеджеры,НадписьИнф,ГруппаCRM;
Перем crmTransaction,crmStage;

Функция crmUUID(crmText)
    Если СтрДлина(crmText)<>36 Тогда Возврат 0; КонецЕсли;
    Для crmN=1 По 36 Цикл
        crmChar=Сред(crmText,crmN,1);
        Если (crmN=9) Или (crmN=14) Или (crmN=19) Или (crmN=24) Тогда
            Если crmChar<>"-" Тогда Возврат 0; КонецЕсли;
        Иначе
            Если Найти("0123456789abcdef",crmChar)=0 Тогда Возврат 0; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Возврат ?(crmText="00000000-0000-0000-0000-000000000000",0,1);
КонецФункции

Функция crmError(crmValue)
    Если ТипЗначенияСтр(crmValue)="Число" Тогда
        Возврат ?(crmValue=-1,1,0);
    КонецЕсли;
    Возврат 0;
КонецФункции

Функция crmExisting(crmID)
    crmSearch=СоздатьОбъект("Документ");
    crmSearch.ВыбратьПоЗначению(,,"Идентификатор",crmID);
    crmFound=""; crmCount=0;
    Пока crmSearch.ПолучитьДокумент()=1 Цикл
        Если crmSearch.Вид()="Заявка" Тогда
            Если СокрЛП(crmSearch.Идентификатор)=crmID Тогда
                crmCount=crmCount+1;
                crmFound=crmSearch.ТекущийДокумент();
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если crmCount>1 Тогда
        Предупреждение("Найдено несколько заявок с одним ключом CRM. Нужна ручная проверка.");
        Возврат -1;
    КонецЕсли;
    Возврат crmFound;
КонецФункции


Процедура crmStop(crmMessage)
    Если crmTransaction=1 Тогда
        ОтменитьТранзакцию(); crmTransaction=0;
        Сообщить("CRM: создание отгрузки отменено.");
    КонецЕсли;
    Предупреждение(crmMessage);
КонецПроцедуры

Функция crmShipmentExists(crmApplication)
    crmSearch=СоздатьОбъект("Документ");
    crmSearch.ВыбратьПодчиненныеДокументы(,,crmApplication);
    crmCount=0;
    Пока crmSearch.ПолучитьДокумент()=1 Цикл
        Если crmSearch.Вид()="ОтгрузкаТурУслуг" Тогда
            crmCount=crmCount+1;
            Сообщить("CRM: для заявки уже существует "+Строка(crmSearch.ТекущийДокумент())+"; проведена: "+Строка(crmSearch.Проведен())+"; пометка удаления: "+Строка(crmSearch.ПометкаУдаления()));
        КонецЕсли;
    КонецЦикла;
    Возврат crmCount;
КонецФункции

Функция crmVoucher(crmApplication)
    crmSearch=СоздатьОбъект("Документ");
    crmSearch.ВыбратьПодчиненныеДокументы(,,crmApplication);
    crmCount=0; crmFound="";
    Пока crmSearch.ПолучитьДокумент()=1 Цикл
        Если crmSearch.Вид()="Путевка" Тогда
            crmCount=crmCount+1; crmFound=crmSearch.ТекущийДокумент();
        КонецЕсли;
    КонецЦикла;
    Если crmCount<>1 Тогда
        Предупреждение("Для первого теста нужна ровно одна путёвка по заявке. Сначала загрузите её или проверьте связанные документы.");
        Возврат -1;
    КонецЕсли;
    Возврат crmFound;
КонецФункции

Функция crmCommissionService()
    // Тот же точный поиск, который использует штатный модуль проведения.
    crmRef=СоздатьОбъект("Справочник.ТурУслуги");
    Если crmRef.НайтиПоНаименованию("Комиссионные путевки",0,1)=0 Тогда
        Предупреждение("В 1С не найдена штатная услуга Комиссионные путевки."); Возврат -1;
    КонецЕсли;
    Если (crmRef.ЭтоГруппа()=1) Или (crmRef.ПометкаУдаления()=1) Тогда
        Предупреждение("Штатная комиссионная услуга помечена на удаление или является группой."); Возврат -1;
    КонецЕсли;
    crmService=crmRef.ТекущийЭлемент();
    crmRef.ВыбратьЭлементы(); crmCount=0;
    Пока crmRef.ПолучитьЭлемент()=1 Цикл
        Если НРег(СокрЛП(crmRef.Наименование))="комиссионные путевки" Тогда crmCount=crmCount+1; КонецЕсли;
    КонецЦикла;
    Если crmCount<>1 Тогда
        Предупреждение("Найдено несколько комиссионных услуг с одинаковым названием. Нужна проверка справочника."); Возврат -1;
    КонецЕсли;
    crmRef.НайтиЭлемент(crmService);
    Если ПустоеЗначение(crmRef.Номенклатура)=1 Тогда
        Предупреждение("В комиссионной услуге не заполнена номенклатура."); Возврат -1;
    КонецЕсли;
    Если crmRef.Номенклатура.ТипНоменклатуры<>Перечисление.ТипыНоменклатуры.ТоварНаКомиссии Тогда
        Предупреждение("Номенклатура услуги должна иметь тип Товар на комиссии. Справочник автоматически не меняется."); Возврат -1;
    КонецЕсли;
    Если ПустоеЗначение(crmRef.Номенклатура.ВидДеятельности)=1 Тогда
        Предупреждение("В номенклатуре комиссионной услуги не заполнен вид деятельности."); Возврат -1;
    КонецЕсли;
    Возврат crmService;
КонецФункции

Функция crmValidSource(crmApp,crmVoucherDoc,crmAmount,crmCost,crmDate)
    Если (crmApp.ПометкаУдаления()=1) Или (crmApp.Проведен()<>1) Тогда Возврат 0; КонецЕсли;
    Если (crmApp.Статус<>Перечисление.СтатусыЗаявок.Оплата) И (crmApp.Статус<>Перечисление.СтатусыЗаявок.Оплачена) И (crmApp.Статус<>Перечисление.СтатусыЗаявок.Закрыта) Тогда Возврат 0; КонецЕсли;
    Если (crmApp.ДатаДок>crmDate) Или (crmApp.Валюта<>Рубль) Или (crmApp.Курс<>1) Тогда Возврат 0; КонецЕсли;
    Если (crmApp.ШтрафОтОператора<>0) Или (crmApp.ШтрафПокупателя<>0) Тогда Возврат 0; КонецЕсли;
    Если (crmApp.ИтогоСумма<>crmAmount) Или (crmApp.ИтогоСебестоимость<>crmCost) Или (crmApp.ИтогоСуммаСкидки<>0) Тогда Возврат 0; КонецЕсли;
    Если (crmApp.КоличествоСтрок()<>1) Или (crmVoucherDoc.КоличествоСтрок()<>1) Тогда Возврат 0; КонецЕсли;
    Если (crmVoucherDoc.ПометкаУдаления()=1) Или (crmVoucherDoc.Проведен()<>1) Тогда Возврат 0; КонецЕсли;
    Если (crmVoucherDoc.ДатаДок>crmDate) Или (crmVoucherDoc.Заявка<>crmApp.ТекущийДокумент()) Тогда Возврат 0; КонецЕсли;
    Если (crmVoucherDoc.Сумма<>crmAmount) Или (crmVoucherDoc.Оплачено<>crmAmount) Или (crmVoucherDoc.УжеОплачено<>0) Или (crmVoucherDoc.Штраф<>0) Тогда Возврат 0; КонецЕсли;
    Если (crmVoucherDoc.Плательщик<>crmApp.Плательщик) Или (crmVoucherDoc.Тур<>crmApp.Тур) Или (crmVoucherDoc.Валюта<>Рубль) Или (crmVoucherDoc.Курс<>1) Тогда Возврат 0; КонецЕсли;
    Если (ПустоеЗначение(crmApp.Плательщик)=1) Или (ПустоеЗначение(crmApp.ТурОператор)=1) Или (ПустоеЗначение(crmApp.ДоговорПлательщика)=1) Или (ПустоеЗначение(crmApp.ДоговорОператора)=1) Тогда Возврат 0; КонецЕсли;
    Если (crmApp.ДоговорПлательщика.Комиссия<>1) Или (crmApp.ДоговорОператора.Комиссия<>1) Тогда Возврат 0; КонецЕсли;
    crmApp.ВыбратьСтроки(); crmApp.ПолучитьСтроку();
    crmVoucherDoc.ВыбратьСтроки(); crmVoucherDoc.ПолучитьСтроку();
    Если (crmApp.Сумма<>crmAmount) Или (crmApp.Себестоимость<>crmCost) Или (crmApp.СуммаСкидки<>0) Тогда Возврат 0; КонецЕсли;
    Если (crmVoucherDoc.Турист<>crmApp.Турист) Или (crmVoucherDoc.Стоимость<>crmAmount) Или (crmVoucherDoc.Себестоимость<>crmCost) Тогда Возврат 0; КонецЕсли;
    Возврат 1;
КонецФункции

Процедура crmImportShipment()
    Если ЗагрузитьВнешнююКомпоненту("V7plus.dll")<>1 Тогда Предупреждение("Не найдена V7Plus.dll."); Возврат; КонецЕсли;
    crmXML=СоздатьОбъект("AddIn.XMLParser");
    Если Число(crmXML.ВерсияАнализатора)<2 Тогда Предупреждение("Нужен XMLParser не ниже 2.0."); Возврат; КонецЕсли;
    crmFile=""; crmDir="";
    Если ФС.ВыбратьФайл(0,crmFile,crmDir,"Выберите exchange.xml из CRM","Пакет CRM (*.xml)|*.xml","xml",)<>1 Тогда Возврат; КонецЕсли;
    crmStage="Чтение XML";
    crmXMLDoc=crmXML.СоздатьДокумент(); crmXMLDoc.Загрузить(crmDir+crmFile);
    crmRoot=crmXMLDoc.ЭлементДокумента;
    Если crmRoot.Наименование<>"CRM_TEST_EXPORT" Тогда Предупреждение("Это не пакет CRM."); Возврат; КонецЕсли;
    Если (crmRoot.ПолучитьАтрибут("VERSION")<>"1") Или (crmRoot.ПолучитьАтрибут("TEST_ONLY")<>"1") Тогда Предупреждение("Версия пакета не поддерживается."); Возврат; КонецЕсли;
    crmNodes=crmRoot.ВыбратьУзлы("CONTRACT");
    Если (crmNodes.КоличествоУзлов<1) Или (crmNodes.КоличествоУзлов>20) Тогда Предупреждение("Выберите тестовый пакет до 20 договоров."); Возврат; КонецЕсли;
    crmList=СоздатьОбъект("СписокЗначений");
    Для crmN=0 По crmNodes.КоличествоУзлов-1 Цикл
        crmNode=crmNodes.ПолучитьУзел(crmN);
        crmList.ДобавитьЗначение(crmN,"Договор "+crmNode.ПолучитьАтрибут("NUMBER")+" от "+crmNode.ПолучитьАтрибут("DATE"));
    КонецЦикла;
    crmChoice=0; crmPosition=1;
    Если crmList.ВыбратьЗначение(crmChoice,"Выберите договор для первой отгрузки",crmPosition,,1)=0 Тогда Возврат; КонецЕсли;
    crmNode=crmNodes.ПолучитьУзел(crmChoice); crmID=crmNode.ПолучитьАтрибут("ID");
    Если crmUUID(crmID)=0 Тогда Предупреждение("Некорректный ключ CRM."); Возврат; КонецЕсли;
    crmStage="Поиск заявки и существующей отгрузки";
    crmApplication=crmExisting(crmID);
    Если crmError(crmApplication)=1 Тогда Возврат; КонецЕсли;
    Если ПустоеЗначение(crmApplication)=1 Тогда Предупреждение("Сначала загрузите заявку."); Возврат; КонецЕсли;
    Если crmShipmentExists(crmApplication)>0 Тогда
        Сообщить("CRM: новая отгрузка не создана, существующая не изменена, доход повторно не начислен."); Возврат;
    КонецЕсли;
    Если crmNode.ПолучитьАтрибут("SHIPMENT_STATUS")<>"in_period" Тогда
        Предупреждение("Дата отгрузки не подтверждена для выбранного года. Проверьте себестоимость и замечания пакета."); Возврат;
    КонецЕсли;
    crmAmount=Число(crmNode.ПолучитьАтрибут("AMOUNT"));
    crmCost=Число(crmNode.ПолучитьАтрибут("COST"));
    crmCommission=Число(crmNode.ПолучитьАтрибут("COMMISSION"));
    Если (crmNode.ПолучитьАтрибут("CURRENCY")<>"RUB") Или (crmCost<=0) Или (crmCommission<=0) Или (crmAmount-crmCost<>crmCommission) Тогда
        Предупреждение("Для первого теста нужны положительная себестоимость и комиссия в рублях."); Возврат;
    КонецЕсли;
    crmDateText=crmNode.ПолучитьАтрибут("SHIPMENT_DATE");
    Если СтрДлина(crmDateText)<>10 Тогда Предупреждение("Не заполнена дата отгрузки."); Возврат; КонецЕсли;
    crmDate=Дата(Прав(crmDateText,2)+"."+Сред(crmDateText,6,2)+"."+Лев(crmDateText,4));
    Если (ДатаГод(crmDate)<>2026) Или (crmRoot.ПолучитьАтрибут("YEAR")<>"2026") Тогда Предупреждение("Первый тест отгрузки предназначен для 2026 года."); Возврат; КонецЕсли;
    crmVoucherRef=crmVoucher(crmApplication);
    Если crmError(crmVoucherRef)=1 Тогда Возврат; КонецЕсли;
    crmApp=СоздатьОбъект("Документ.Заявка"); crmApp.НайтиДокумент(crmApplication);
    crmVoucherDoc=СоздатьОбъект("Документ.Путевка"); crmVoucherDoc.НайтиДокумент(crmVoucherRef);
    Если crmValidSource(crmApp,crmVoucherDoc,crmAmount,crmCost,crmDate)=0 Тогда
        Предупреждение("Заявка и путёвка должны быть проведены, иметь одну строку заказчика и совпадающие с пакетом суммы. Проверьте также даты, валюту, отсутствие штрафов и признак комиссии в договорах расчётов."); Возврат;
    КонецЕсли;
    crmStage="Проверка комиссионной услуги";
    crmService=crmCommissionService();
    Если crmError(crmService)=1 Тогда Возврат; КонецЕсли;
    Если ПустоеЗначение(Константа.ДатаПереходаНаУСН)=1 Тогда Предупреждение("В 1С не установлена дата перехода на УСН."); Возврат; КонецЕсли;
    crmPrompt="Создать и провести одну отгрузку в тестовой базе?"+РазделительСтрок;
    crmPrompt=crmPrompt+Строка(crmApplication)+"; "+Строка(crmVoucherRef)+РазделительСтрок;
    crmPrompt=crmPrompt+"Дата: "+crmDateText+"; сумма: "+Строка(crmAmount)+"; комиссия целиком: "+Строка(crmCommission);
    Если Вопрос(crmPrompt,4)<>6 Тогда Возврат; КонецЕсли;
    crmStage="Создание отгрузки";
    НачатьТранзакцию(); crmTransaction=1;
    Если crmShipmentExists(crmApplication)>0 Тогда crmStop("Отгрузка уже существует. Повторное создание отменено."); Возврат; КонецЕсли;
    crmApp.НайтиДокумент(crmApplication); crmVoucherDoc.НайтиДокумент(crmVoucherRef);
    Если crmValidSource(crmApp,crmVoucherDoc,crmAmount,crmCost,crmDate)=0 Тогда crmStop("Исходные документы изменились, нужна сверка."); Возврат; КонецЕсли;
    crmShip=СоздатьОбъект("Документ.ОтгрузкаТурУслуг");
    crmShip.Новый(); crmShip.ДатаДок=crmDate; crmShip.УстановитьНовыйНомер();
    crmShip.Заявка=crmApplication;
    crmShip.Плательщик=crmApp.Плательщик; crmShip.ДоговорПлательщика=crmApp.ДоговорПлательщика;
    crmShip.ТурОператор=crmApp.ТурОператор; crmShip.ДоговорОператора=crmApp.ДоговорОператора;
    crmShip.Валюта=crmApp.Валюта; crmShip.Курс=1;
    crmShip.НоваяСтрока(); crmShip.Услуга=crmService; crmShip.Путевка=crmVoucherRef;
    crmShip.Сумма=crmAmount; crmShip.Комиссия=crmCommission;
    crmStage="Штатное проведение отгрузки";
    crmShip.Записать(); crmShip.Провести();
    Если crmShip.Проведен()<>1 Тогда crmStop("Отгрузка не проведена. Проверьте штатные сообщения 1С."); Возврат; КонецЕсли;
    crmSaved=crmShip.ТекущийДокумент();
    crmStage="Проверка сохранённой отгрузки";
    crmCheck=СоздатьОбъект("Документ.ОтгрузкаТурУслуг"); crmCheck.НайтиДокумент(crmSaved);
    Если (crmCheck.Проведен()<>1) Или (crmCheck.Заявка<>crmApplication) Или (crmCheck.ДатаДок<>crmDate) Или (crmCheck.КоличествоСтрок()<>1) Тогда crmStop("Не прошла проверка записанной отгрузки."); Возврат; КонецЕсли;
    crmCheck.ВыбратьСтроки(); crmCheck.ПолучитьСтроку();
    Если (crmCheck.Услуга<>crmService) Или (crmCheck.Путевка<>crmVoucherRef) Или (crmCheck.Сумма<>crmAmount) Или (crmCheck.Комиссия<>crmCommission) Тогда crmStop("Суммы или связи записанной отгрузки отличаются от проекта."); Возврат; КонецЕсли;
    ЗафиксироватьТранзакцию(); crmTransaction=0;
    Сообщить("CRM: создана и проведена "+Строка(crmSaved)+" на основании "+Строка(crmApplication));
    Сообщить("CRM: дата отгрузки "+crmDateText+"; сумма "+Строка(crmAmount)+"; комиссия "+Строка(crmCommission));
    Сообщить("CRM: заявка и путёвка не перепроводились, бланк повторно не списывался. Клиентские платежи пока не создавались.");
    Сообщить("CRM: проверьте проводки выручки по комиссии и налогового учёта. Повторите тот же договор для проверки отсутствия дубля.");
    crmStage="Просмотр отгрузки";
    ОткрытьФорму(crmSaved);
КонецПроцедуры

Процедура ПриОткрытии()
    crmTransaction=0; crmStage="Запуск";
    Попытка
        crmImportShipment();
    Исключение
        Если crmTransaction=1 Тогда ОтменитьТранзакцию(); crmTransaction=0; Сообщить("CRM: создание отгрузки отменено."); КонецЕсли;
        Предупреждение("Отгрузка CRM ("+crmStage+"): "+ОписаниеОшибки());
    КонецПопытки;
    СтатусВозврата(0);
КонецПроцедуры
