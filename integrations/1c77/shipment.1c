// Первый тест отгрузки: одна существующая заявка и проведённая путёвка.
// Штатное проведение 1С. Полная комиссия, без изменения старых документов.
Перем Connection,тзТипыКонтрагентов,тзМенеджеры,НадписьИнф,ГруппаCRM;
Перем crmTransaction,crmStage;

Функция crmUUID(crmText)
    Если СтрДлина(crmText)<>36 Тогда Возврат 0; КонецЕсли;
    Для crmN=1 По 36 Цикл
        crmChar=Сред(crmText,crmN,1);
        Если (crmN=9) Или (crmN=14) Или (crmN=19) Или (crmN=24) Тогда
            Если crmChar<>"-" Тогда Возврат 0; КонецЕсли;
        Иначе
            Если Найти("0123456789abcdef",crmChar)=0 Тогда Возврат 0; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Возврат ?(crmText="00000000-0000-0000-0000-000000000000",0,1);
КонецФункции

Функция crmError(crmValue)
    Если ТипЗначенияСтр(crmValue)="Число" Тогда
        Возврат ?(crmValue=-1,1,0);
    КонецЕсли;
    Возврат 0;
КонецФункции

Функция crmExisting(crmID)
    crmSearch=СоздатьОбъект("Документ");
    crmSearch.ВыбратьПоЗначению(,,"Идентификатор",crmID);
    crmFound=""; crmCount=0;
    Пока crmSearch.ПолучитьДокумент()=1 Цикл
        Если crmSearch.Вид()="Заявка" Тогда
            Если СокрЛП(crmSearch.Идентификатор)=crmID Тогда
                crmCount=crmCount+1;
                crmFound=crmSearch.ТекущийДокумент();
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если crmCount>1 Тогда
        Предупреждение("Найдено несколько заявок с одним ключом CRM. Нужна ручная проверка.");
        Возврат -1;
    КонецЕсли;
    Возврат crmFound;
КонецФункции


Процедура crmStop(crmMessage)
    Если crmTransaction=1 Тогда
        ОтменитьТранзакцию(); crmTransaction=0;
        Сообщить("CRM: создание отгрузки отменено.");
    КонецЕсли;
    Предупреждение(crmMessage);
КонецПроцедуры

Функция crmShipmentExists(crmApplication)
    crmSearch=СоздатьОбъект("Документ");
    crmSearch.ВыбратьПодчиненныеДокументы(,,crmApplication);
    crmCount=0;
    Пока crmSearch.ПолучитьДокумент()=1 Цикл
        Если crmSearch.Вид()="ОтгрузкаТурУслуг" Тогда
            crmCount=crmCount+1;

        КонецЕсли;
    КонецЦикла;
    Возврат crmCount;
КонецФункции

Функция crmVoucher(crmApplication)
    crmSearch=СоздатьОбъект("Документ");
    crmSearch.ВыбратьПодчиненныеДокументы(,,crmApplication);
    crmCount=0; crmFound="";
    Пока crmSearch.ПолучитьДокумент()=1 Цикл
        Если crmSearch.Вид()="Путевка" Тогда
            crmCount=crmCount+1; crmFound=crmSearch.ТекущийДокумент();
        КонецЕсли;
    КонецЦикла;
    Если crmCount<>1 Тогда
        Предупреждение("Для первого теста нужна ровно одна путёвка по заявке. Сначала загрузите её или проверьте связанные документы.");
        Возврат -1;
    КонецЕсли;
    Возврат crmFound;
КонецФункции

Функция crmCommissionService()
    // Тот же точный поиск, который использует штатный модуль проведения.
    crmRef=СоздатьОбъект("Справочник.ТурУслуги");
    Если crmRef.НайтиПоНаименованию("Комиссионные путевки",0,1)=0 Тогда
        Предупреждение("В 1С не найдена штатная услуга Комиссионные путевки."); Возврат -1;
    КонецЕсли;
    Если (crmRef.ЭтоГруппа()=1) Или (crmRef.ПометкаУдаления()=1) Тогда
        Предупреждение("Штатная комиссионная услуга помечена на удаление или является группой."); Возврат -1;
    КонецЕсли;
    crmService=crmRef.ТекущийЭлемент();
    crmRef.ВыбратьЭлементы(); crmCount=0;
    Пока crmRef.ПолучитьЭлемент()=1 Цикл
        Если НРег(СокрЛП(crmRef.Наименование))="комиссионные путевки" Тогда crmCount=crmCount+1; КонецЕсли;
    КонецЦикла;
    Если crmCount<>1 Тогда
        Предупреждение("Найдено несколько комиссионных услуг с одинаковым названием. Нужна проверка справочника."); Возврат -1;
    КонецЕсли;
    crmRef.НайтиЭлемент(crmService);
    Если ПустоеЗначение(crmRef.Номенклатура)=1 Тогда
        Предупреждение("В комиссионной услуге не заполнена номенклатура."); Возврат -1;
    КонецЕсли;
    Если crmRef.Номенклатура.ТипНоменклатуры<>Перечисление.ТипыНоменклатуры.ТоварНаКомиссии Тогда
        Предупреждение("Номенклатура услуги должна иметь тип Товар на комиссии. Справочник автоматически не меняется."); Возврат -1;
    КонецЕсли;
    Если ПустоеЗначение(crmRef.Номенклатура.ВидДеятельности)=1 Тогда
        Предупреждение("В номенклатуре комиссионной услуги не заполнен вид деятельности."); Возврат -1;
    КонецЕсли;
    Возврат crmService;
КонецФункции

Функция crmDifference(crmLabel,crmActual,crmExpected)
    Если crmActual=crmExpected Тогда Возврат ""; КонецЕсли;
    Возврат crmLabel+": в 1С ["+Строка(crmActual)+"], ожидается ["+Строка(crmExpected)+"]."+РазделительСтрок;
КонецФункции

Функция crmSourceIssues(crmApp,crmVoucherDoc,crmAmount,crmCost,crmDate,crmAllowEmptyStatus=0)
    crmIssues="";
    crmIssues=crmIssues+crmDifference("Заявка: пометка удаления",crmApp.ПометкаУдаления(),0);
    crmIssues=crmIssues+crmDifference("Заявка: проведена",crmApp.Проведен(),1);
    Если (crmApp.Статус<>Перечисление.СтатусыЗаявок.Оплата) И (crmApp.Статус<>Перечисление.СтатусыЗаявок.Оплачена) И (crmApp.Статус<>Перечисление.СтатусыЗаявок.Закрыта) Тогда
        Если (crmAllowEmptyStatus=0) Или (ПустоеЗначение(crmApp.Статус)=0) Тогда
            crmIssues=crmIssues+"Заявка: статус ["+Строка(crmApp.Статус)+"], ожидается Оплата, Оплачена или Закрыта."+РазделительСтрок;
        КонецЕсли;
    КонецЕсли;
    Если crmApp.ДатаДок>crmDate Тогда crmIssues=crmIssues+"Заявка: дата "+Строка(crmApp.ДатаДок)+" позже даты отгрузки "+Строка(crmDate)+"."+РазделительСтрок; КонецЕсли;
    Если crmApp.Валюта<>Рубль Тогда crmIssues=crmIssues+"Заявка: валюта не рублёвая."+РазделительСтрок; КонецЕсли;
    crmIssues=crmIssues+crmDifference("Заявка: курс",crmApp.Курс,1);
    crmIssues=crmIssues+crmDifference("Заявка: штраф от ТО",crmApp.ШтрафОтОператора,0);
    crmIssues=crmIssues+crmDifference("Заявка: штраф покупателя",crmApp.ШтрафПокупателя,0);
    crmIssues=crmIssues+crmDifference("Заявка: итоговая сумма",crmApp.ИтогоСумма,crmAmount);
    crmIssues=crmIssues+crmDifference("Заявка: итоговая себестоимость",crmApp.ИтогоСебестоимость,crmCost);
    crmIssues=crmIssues+crmDifference("Заявка: итоговая скидка",crmApp.ИтогоСуммаСкидки,0);
    crmIssues=crmIssues+crmDifference("Заявка: строк",crmApp.КоличествоСтрок(),1);
    crmIssues=crmIssues+crmDifference("Путёвка: строк",crmVoucherDoc.КоличествоСтрок(),1);
    crmIssues=crmIssues+crmDifference("Путёвка: пометка удаления",crmVoucherDoc.ПометкаУдаления(),0);
    crmIssues=crmIssues+crmDifference("Путёвка: проведена",crmVoucherDoc.Проведен(),1);
    // Служебная путёвка на 31 декабря не переносит дату признания комиссии.
    Если (crmVoucherDoc.ДатаДок>crmDate) И (crmVoucherDoc.ДатаДок<>КонГода(crmDate)) Тогда
        crmIssues=crmIssues+"Путёвка: дата "+Строка(crmVoucherDoc.ДатаДок)+" позже отгрузки и не является концом её года."+РазделительСтрок;
    КонецЕсли;
    Если crmVoucherDoc.Заявка<>crmApp.ТекущийДокумент() Тогда crmIssues=crmIssues+"Путёвка: ссылка на другую заявку."+РазделительСтрок; КонецЕсли;
    crmIssues=crmIssues+crmDifference("Путёвка: общая сумма",crmVoucherDoc.Сумма,crmAmount);
    crmIssues=crmIssues+crmDifference("Путёвка: оплачено",crmVoucherDoc.Оплачено,crmAmount);
    crmIssues=crmIssues+crmDifference("Путёвка: уже оплачено",crmVoucherDoc.УжеОплачено,0);
    crmIssues=crmIssues+crmDifference("Путёвка: штраф",crmVoucherDoc.Штраф,0);
    Если crmVoucherDoc.Плательщик<>crmApp.Плательщик Тогда crmIssues=crmIssues+"Путёвка: плательщик отличается от заявки."+РазделительСтрок; КонецЕсли;
    Если crmVoucherDoc.Тур<>crmApp.Тур Тогда crmIssues=crmIssues+"Путёвка: тур отличается от заявки."+РазделительСтрок; КонецЕсли;
    Если crmVoucherDoc.Валюта<>Рубль Тогда crmIssues=crmIssues+"Путёвка: валюта не рублёвая."+РазделительСтрок; КонецЕсли;
    crmIssues=crmIssues+crmDifference("Путёвка: курс",crmVoucherDoc.Курс,1);
    Если ПустоеЗначение(crmApp.Плательщик)=1 Тогда crmIssues=crmIssues+"Заявка: не заполнен плательщик."+РазделительСтрок; КонецЕсли;
    Если ПустоеЗначение(crmApp.ТурОператор)=1 Тогда crmIssues=crmIssues+"Заявка: не заполнен ТО."+РазделительСтрок; КонецЕсли;
    Если ПустоеЗначение(crmApp.ДоговорПлательщика)=1 Тогда
        crmIssues=crmIssues+"Заявка: не заполнен договор плательщика."+РазделительСтрок;
    Иначе
        crmIssues=crmIssues+crmDifference("Договор плательщика: признак комиссии",crmApp.ДоговорПлательщика.Комиссия,1);
    КонецЕсли;
    Если ПустоеЗначение(crmApp.ДоговорОператора)=1 Тогда
        crmIssues=crmIssues+"Заявка: не заполнен договор оператора."+РазделительСтрок;
    Иначе
        crmIssues=crmIssues+crmDifference("Договор оператора: признак комиссии",crmApp.ДоговорОператора.Комиссия,1);
    КонецЕсли;
    Если crmApp.КоличествоСтрок()=1 Тогда
        crmApp.ВыбратьСтроки(); crmApp.ПолучитьСтроку();
        crmIssues=crmIssues+crmDifference("Строка заявки: сумма",crmApp.Сумма,crmAmount);
        crmIssues=crmIssues+crmDifference("Строка заявки: себестоимость",crmApp.Себестоимость,crmCost);
        crmIssues=crmIssues+crmDifference("Строка заявки: скидка",crmApp.СуммаСкидки,0);
    КонецЕсли;
    Если crmVoucherDoc.КоличествоСтрок()=1 Тогда
        crmVoucherDoc.ВыбратьСтроки(); crmVoucherDoc.ПолучитьСтроку();
        crmIssues=crmIssues+crmDifference("Строка путёвки: стоимость",crmVoucherDoc.Стоимость,crmAmount);
        crmIssues=crmIssues+crmDifference("Строка путёвки: себестоимость",crmVoucherDoc.Себестоимость,crmCost);
        Если crmApp.КоличествоСтрок()=1 Тогда
            Если crmVoucherDoc.Турист<>crmApp.Турист Тогда crmIssues=crmIssues+"Турист в строке путёвки отличается от строки заявки."+РазделительСтрок; КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    Возврат crmIssues;
КонецФункции

Процедура crmImportShipment(crmBatch=0,crmBatchRoot="",crmBatchIndex=0,crmResult="",crmResultReason="")
    crmResult="failed"; crmResultReason="";
    Если crmBatch=1 Тогда
        crmRoot=crmBatchRoot;
    Иначе
        Если ЗагрузитьВнешнююКомпоненту("V7plus.dll")<>1 Тогда Предупреждение("Не найдена V7Plus.dll."); Возврат; КонецЕсли;
        crmXML=СоздатьОбъект("AddIn.XMLParser");
        Если Число(crmXML.ВерсияАнализатора)<2 Тогда Предупреждение("Нужен XMLParser не ниже 2.0."); Возврат; КонецЕсли;
        crmFile=""; crmDir="";
        Если ФС.ВыбратьФайл(0,crmFile,crmDir,"Выберите exchange.xml из CRM","Пакет CRM (*.xml)|*.xml","xml",)<>1 Тогда Возврат; КонецЕсли;
        crmStage="Чтение XML";
        crmXMLDoc=crmXML.СоздатьДокумент(); crmXMLDoc.Загрузить(crmDir+crmFile);
        crmRoot=crmXMLDoc.ЭлементДокумента;
    КонецЕсли;
    Если crmRoot.Наименование<>"CRM_TEST_EXPORT" Тогда Предупреждение("Это не пакет CRM."); Возврат; КонецЕсли;
    Если (crmRoot.ПолучитьАтрибут("VERSION")<>"1") Или (crmRoot.ПолучитьАтрибут("TEST_ONLY")<>"1") Тогда Предупреждение("Версия пакета не поддерживается."); Возврат; КонецЕсли;
    crmNodes=crmRoot.ВыбратьУзлы("CONTRACT");
    Если crmNodes.КоличествоУзлов<1 Тогда Предупреждение("В пакете нет договоров."); Возврат; КонецЕсли;
    Если crmBatch=1 Тогда
        Если (crmBatchIndex<0) Или (crmBatchIndex>=crmNodes.КоличествоУзлов) Тогда Возврат; КонецЕсли;
        crmChoice=crmBatchIndex;
    Иначе
    crmList=СоздатьОбъект("СписокЗначений");
    Для crmN=0 По crmNodes.КоличествоУзлов-1 Цикл
        crmNode=crmNodes.ПолучитьУзел(crmN);
        crmList.ДобавитьЗначение(crmN,"Договор "+crmNode.ПолучитьАтрибут("NUMBER")+" от "+crmNode.ПолучитьАтрибут("DATE"));
    КонецЦикла;
    crmChoice=0; crmPosition=1;
        Если crmList.ВыбратьЗначение(crmChoice,"Выберите договор для первой отгрузки",crmPosition,,1)=0 Тогда Возврат; КонецЕсли;
    КонецЕсли;
    crmNode=crmNodes.ПолучитьУзел(crmChoice); crmID=crmNode.ПолучитьАтрибут("ID");
    Если crmUUID(crmID)=0 Тогда Предупреждение("Некорректный ключ CRM."); Возврат; КонецЕсли;
    Если crmBatch=1 Тогда
        crmShipmentStatus=crmNode.ПолучитьАтрибут("SHIPMENT_STATUS");
        Если crmShipmentStatus<>"in_period" Тогда
            Если crmShipmentStatus="not_reached" Тогда
                crmResult="not_ready"; crmResultReason="Оплата ещё не превысила себестоимость";
            ИначеЕсли crmShipmentStatus="storno" Тогда
                crmResult="not_ready"; crmResultReason="Отрицательный договор отражается операцией Сторно";
            ИначеЕсли crmShipmentStatus="partially_paid" Тогда
                crmResult="not_ready"; crmResultReason="Договор ещё не полностью оплачен";
            ИначеЕсли crmShipmentStatus="outside_period" Тогда
                crmResult="not_ready"; crmResultReason="Дата отгрузки вне выбранного года";
            ИначеЕсли crmShipmentStatus="requires_review" Тогда
                crmResult="not_ready"; crmResultReason="Нужна проверка себестоимости, комиссии, возвратов или зачётов";
            Иначе
                crmResultReason="В пакете неизвестный статус готовности отгрузки";
            КонецЕсли;
            Сообщить("CRM: договор "+crmNode.ПолучитьАтрибут("NUMBER")+": "+crmResultReason+". Отгрузка не создавалась."); Возврат;
        КонецЕсли;
    КонецЕсли;
    crmStage="Поиск заявки и существующей отгрузки";
    crmApplication=crmExisting(crmID);
    Если crmError(crmApplication)=1 Тогда Возврат; КонецЕсли;
    Если ПустоеЗначение(crmApplication)=1 Тогда Предупреждение("Сначала загрузите заявку."); Возврат; КонецЕсли;
    Если crmShipmentExists(crmApplication)>0 Тогда
        crmResult="existing";
         Возврат;
    КонецЕсли;
    Если crmNode.ПолучитьАтрибут("SHIPMENT_STATUS")<>"in_period" Тогда
        Предупреждение("Дата отгрузки не подтверждена для выбранного года. Проверьте себестоимость и замечания пакета."); Возврат;
    КонецЕсли;
    crmAmount=Число(crmNode.ПолучитьАтрибут("AMOUNT"));
    crmCost=Число(crmNode.ПолучитьАтрибут("COST"));
    crmCommission=Число(crmNode.ПолучитьАтрибут("COMMISSION"));
    Если (crmNode.ПолучитьАтрибут("CURRENCY")<>"RUB") Или (crmCost<=0) Или (crmCommission<=0) Или (crmAmount-crmCost<>crmCommission) Тогда
        Предупреждение("Для первого теста нужны положительная себестоимость и комиссия в рублях."); Возврат;
    КонецЕсли;
    crmDateText=crmNode.ПолучитьАтрибут("SHIPMENT_DATE");
    Если СтрДлина(crmDateText)<>10 Тогда Предупреждение("Не заполнена дата отгрузки."); Возврат; КонецЕсли;
    crmDate=Дата(Прав(crmDateText,2)+"."+Сред(crmDateText,6,2)+"."+Лев(crmDateText,4));
    Если (ДатаГод(crmDate)<>2026) Или (crmRoot.ПолучитьАтрибут("YEAR")<>"2026") Тогда Предупреждение("Первый тест отгрузки предназначен для 2026 года."); Возврат; КонецЕсли;
    crmVoucherRef=crmVoucher(crmApplication);
    Если crmError(crmVoucherRef)=1 Тогда Возврат; КонецЕсли;
    crmApp=СоздатьОбъект("Документ.Заявка"); crmApp.НайтиДокумент(crmApplication);
    crmVoucherDoc=СоздатьОбъект("Документ.Путевка"); crmVoucherDoc.НайтиДокумент(crmVoucherRef);
    crmRepairStatus=0;
    Если ПустоеЗначение(crmApp.Статус)=1 Тогда
        Если (Найти(crmApp.Примечания,"Ключ CRM: "+crmID)>0) И (Найти(crmApp.Примечания,"Договор CRM №")>0) Тогда
            crmRepairStatus=1;
        КонецЕсли;
    КонецЕсли;
    crmIssues=crmSourceIssues(crmApp,crmVoucherDoc,crmAmount,crmCost,crmDate,crmRepairStatus);
    Если ПустаяСтрока(crmIssues)=0 Тогда
        Сообщить("CRM: сверка "+Строка(crmApplication)+" и "+Строка(crmVoucherRef));
        Сообщить(crmIssues);
        Предупреждение("Отгрузка не создана. Причины:"+РазделительСтрок+crmIssues); Возврат;
    КонецЕсли;
    crmStage="Проверка комиссионной услуги";
    crmService=crmCommissionService();
    Если crmError(crmService)=1 Тогда Возврат; КонецЕсли;
    Если ПустоеЗначение(Константа.ДатаПереходаНаУСН)=1 Тогда Предупреждение("В 1С не установлена дата перехода на УСН."); Возврат; КонецЕсли;
    crmPrompt="Создать и провести одну отгрузку в тестовой базе?"+РазделительСтрок;
    crmPrompt=crmPrompt+Строка(crmApplication)+"; "+Строка(crmVoucherRef)+РазделительСтрок;
    crmPrompt=crmPrompt+"Дата: "+crmDateText+"; сумма: "+Строка(crmAmount)+"; комиссия целиком: "+Строка(crmCommission);
    Если crmRepairStatus=1 Тогда
        crmPrompt=crmPrompt+РазделительСтрок+"Пустой статус импортированной заявки будет восстановлен на Оплата, заявка перепроведена. Будут добавлены штатные Услуги по заявке, если их нет.";
    КонецЕсли;
    Если crmBatch=0 Тогда
        Если Вопрос(crmPrompt,4)<>6 Тогда Возврат; КонецЕсли;
    КонецЕсли;
    crmStage="Создание отгрузки";
    НачатьТранзакцию(); crmTransaction=1;
    Если crmShipmentExists(crmApplication)>0 Тогда crmStop("Отгрузка уже существует. Повторное создание отменено."); Возврат; КонецЕсли;
    crmApp.НайтиДокумент(crmApplication); crmVoucherDoc.НайтиДокумент(crmVoucherRef);
    crmIssues=crmSourceIssues(crmApp,crmVoucherDoc,crmAmount,crmCost,crmDate,crmRepairStatus);
    Если ПустаяСтрока(crmIssues)=0 Тогда
        Сообщить(crmIssues);
        crmStop("Исходные документы изменились:"+РазделительСтрок+crmIssues); Возврат;
    КонецЕсли;
    crmStage="Штатные услуги заявки и восстановление статуса";
    Если crmEnsureApplicationServices(crmApplication)=0 Тогда crmStop("Не удалось подготовить штатные услуги заявки."); Возврат; КонецЕсли;
    Если ПустоеЗначение(crmApp.Статус)=1 Тогда
        Если (crmRepairStatus<>1) Или (Найти(crmApp.Примечания,"Ключ CRM: "+crmID)=0) Или (Найти(crmApp.Примечания,"Договор CRM №")=0) Тогда
            crmStop("Пустой статус не относится к подтверждённой импортированной заявке. Восстановление отменено."); Возврат;
        КонецЕсли;
        crmApp.Статус=Перечисление.СтатусыЗаявок.Оплата;
        crmApp.Записать(); crmApp.Провести();
        crmApp.НайтиДокумент(crmApplication);
        Сообщить("CRM: восстановлен пустой статус импортированной заявки на Оплата, заявка перепроведена.");
    КонецЕсли;
    crmIssues=crmSourceIssues(crmApp,crmVoucherDoc,crmAmount,crmCost,crmDate);
    Если ПустаяСтрока(crmIssues)=0 Тогда crmStop("Не прошла проверка после восстановления:"+РазделительСтрок+crmIssues); Возврат; КонецЕсли;
    crmStage="Заполнение отгрузки";
    crmShip=СоздатьОбъект("Документ.ОтгрузкаТурУслуг");
    crmShip.Новый(); crmShip.ДатаДок=crmDate; crmShip.УстановитьНовыйНомер();
    crmShip.Заявка=crmApplication;
    crmShip.Плательщик=crmApp.Плательщик; crmShip.ДоговорПлательщика=crmApp.ДоговорПлательщика;
    crmShip.ТурОператор=crmApp.ТурОператор; crmShip.ДоговорОператора=crmApp.ДоговорОператора;
    crmShip.Валюта=crmApp.Валюта; crmShip.Курс=1;
    crmShip.НоваяСтрока(); crmShip.Услуга=crmService; crmShip.Путевка=crmVoucherRef;
    crmShip.Сумма=crmAmount; crmShip.Комиссия=crmCommission;
    crmStage="Штатное проведение отгрузки";
    crmShip.Записать(); crmShip.Провести();
    Если crmShip.Проведен()<>1 Тогда crmStop("Отгрузка не проведена. Проверьте штатные сообщения 1С."); Возврат; КонецЕсли;
    crmSaved=crmShip.ТекущийДокумент();
    crmStage="Проверка сохранённой отгрузки";
    crmCheck=СоздатьОбъект("Документ.ОтгрузкаТурУслуг"); crmCheck.НайтиДокумент(crmSaved);
    Если (crmCheck.Проведен()<>1) Или (crmCheck.Заявка<>crmApplication) Или (crmCheck.ДатаДок<>crmDate) Или (crmCheck.КоличествоСтрок()<>1) Тогда crmStop("Не прошла проверка записанной отгрузки."); Возврат; КонецЕсли;
    crmCheck.ВыбратьСтроки(); crmCheck.ПолучитьСтроку();
    Если (crmCheck.Услуга<>crmService) Или (crmCheck.Путевка<>crmVoucherRef) Или (crmCheck.Сумма<>crmAmount) Или (crmCheck.Комиссия<>crmCommission) Тогда crmStop("Суммы или связи записанной отгрузки отличаются от проекта."); Возврат; КонецЕсли;
    ЗафиксироватьТранзакцию(); crmTransaction=0; crmResult="created";




    crmStage="Просмотр отгрузки";
    Если crmBatch=0 Тогда ОткрытьФорму(crmSaved); КонецЕсли;
КонецПроцедуры

Процедура ПриОткрытии()
    crmTransaction=0; crmStage="Запуск";
    Попытка
        crmImportShipment();
    Исключение
        Если crmTransaction=1 Тогда ОтменитьТранзакцию(); crmTransaction=0; Сообщить("CRM: создание отгрузки отменено."); КонецЕсли;
        Предупреждение("Отгрузка CRM ("+crmStage+"): "+ОписаниеОшибки());
    КонецПопытки;
    СтатусВозврата(0);
КонецПроцедуры
