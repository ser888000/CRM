// Тест: одна оплата картой/СБП, зачёт или штатный ПКО/РКО.
// Никаких выписок банка. Основания берутся по ссылкам из заявок.
Перем Connection,тзТипыКонтрагентов,тзМенеджеры,НадписьИнф,ГруппаCRM;
Перем crmTransaction,crmStage;

Функция crmUUID(crmText)
    Если СтрДлина(crmText)<>36 Тогда Возврат 0; КонецЕсли;
    Для crmN=1 По 36 Цикл
        crmChar=Сред(crmText,crmN,1);
        Если (crmN=9) Или (crmN=14) Или (crmN=19) Или (crmN=24) Тогда
            Если crmChar<>"-" Тогда Возврат 0; КонецЕсли;
        Иначе
            Если Найти("0123456789abcdef",crmChar)=0 Тогда Возврат 0; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Возврат ?(crmText="00000000-0000-0000-0000-000000000000",0,1);
КонецФункции

Функция crmError(crmValue)
    Если ТипЗначенияСтр(crmValue)="Число" Тогда
        Возврат ?(crmValue=-1,1,0);
    КонецЕсли;
    Возврат 0;
КонецФункции

Функция crmExisting(crmID)
    crmSearch=СоздатьОбъект("Документ");
    crmSearch.ВыбратьПоЗначению(,,"Идентификатор",crmID);
    crmFound=""; crmCount=0;
    Пока crmSearch.ПолучитьДокумент()=1 Цикл
        Если crmSearch.Вид()="Заявка" Тогда
            Если СокрЛП(crmSearch.Идентификатор)=crmID Тогда
                crmCount=crmCount+1;
                crmFound=crmSearch.ТекущийДокумент();
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если crmCount>1 Тогда
        Предупреждение("Найдено несколько заявок с одним ключом CRM. Нужна ручная проверка.");
        Возврат -1;
    КонецЕсли;
    Возврат crmFound;
КонецФункции

Функция crmName(crmValue)
    crmNormalized=НРег(СокрЛП(crmValue));
    Пока Найти(crmNormalized,"  ")>0 Цикл crmNormalized=СтрЗаменить(crmNormalized,"  "," "); КонецЦикла;
    Возврат crmNormalized;
КонецФункции

Процедура crmStop(crmMessage)
    Если crmTransaction=1 Тогда ОтменитьТранзакцию(); crmTransaction=0; КонецЕсли;
    Предупреждение(crmMessage);
КонецПроцедуры

Функция crmContractNode(crmRoot,crmID)
    crmNodes=crmRoot.ВыбратьУзлы("CONTRACT"); crmFound=""; crmCount=0;
    Для crmN=0 По crmNodes.КоличествоУзлов-1 Цикл
        crmNode=crmNodes.ПолучитьУзел(crmN);
        Если crmNode.ПолучитьАтрибут("ID")=crmID Тогда crmFound=crmNode; crmCount=crmCount+1; КонецЕсли;
    КонецЦикла;
    Если crmCount<>1 Тогда Предупреждение("В пакете нет единственного договора для операции."); Возврат -1; КонецЕсли;
    Возврат crmFound;
КонецФункции

Функция crmPaymentNode(crmContract,crmID)
    crmNodes=crmContract.ВыбратьУзлы("PAYMENT"); crmCount=0; crmFound="";
    Для crmN=0 По crmNodes.КоличествоУзлов-1 Цикл
        crmNode=crmNodes.ПолучитьУзел(crmN);
        Если crmNode.ПолучитьАтрибут("ID")=crmID Тогда crmFound=crmNode; crmCount=crmCount+1; КонецЕсли;
    КонецЦикла;
    Если crmCount<>1 Тогда Предупреждение("Не найдена единственная исходная оплата в договоре XML."); Возврат -1; КонецЕсли;
    Возврат crmFound;
КонецФункции

Функция crmApplicationForPayment(crmRoot,crmContractID,crmPayer)
    Если crmUUID(crmContractID)=0 Тогда Предупреждение("Некорректный ключ договора."); Возврат -1; КонецЕсли;
    crmContract=crmContractNode(crmRoot,crmContractID);
    Если crmError(crmContract)=1 Тогда Возврат -1; КонецЕсли;
    crmCustomer=crmContract.ВыбратьУзел("CUSTOMER");
    Если ПустоеЗначение(crmCustomer)=1 Тогда Предупреждение("В пакете нет заказчика."); Возврат -1; КонецЕсли;
    Если (crmPayer.ПолучитьАтрибут("ID")<>crmCustomer.ПолучитьАтрибут("ID")) Или (crmName(crmPayer.ПолучитьАтрибут("NAME"))<>crmName(crmCustomer.ПолучитьАтрибут("NAME"))) Тогда
        Предупреждение("Плательщик отличается от заказчика договора. Такая оплата требует отдельного согласования аналитики."); Возврат -1;
    КонецЕсли;
    crmApplication=crmExisting(crmContractID);
    Если crmError(crmApplication)=1 Тогда Возврат -1; КонецЕсли;
    Если ПустоеЗначение(crmApplication)=1 Тогда Предупреждение("Сначала загрузите заявку для договора."); Возврат -1; КонецЕсли;
    crmDoc=СоздатьОбъект("Документ.Заявка"); crmDoc.НайтиДокумент(crmApplication);
    Если (crmDoc.ПометкаУдаления()=1) Или (crmDoc.Проведен()<>1) Тогда
        Предупреждение("Для оплаты нужна проведённая заявка без пометки удаления."); Возврат -1;
    КонецЕсли;
    Если (Найти(crmDoc.Примечания,"Ключ CRM: "+crmContractID)=0) Или (ПустоеЗначение(crmDoc.Плательщик)=1) Или (ПустоеЗначение(crmDoc.ДоговорПлательщика)=1) Тогда
        Предупреждение("Не подтверждены служебная метка заявки или её основания."); Возврат -1;
    КонецЕсли;
    crmPayerRef=СоздатьОбъект("Справочник.Контрагенты"); crmPayerRef.НайтиЭлемент(crmDoc.Плательщик);
    crmPayerName=crmPayerRef.ПолнНаименование;
    Если ПустаяСтрока(crmPayerName)=1 Тогда crmPayerName=crmPayerRef.Наименование; КонецЕсли;
    Если (crmPayerRef.ПометкаУдаления()=1) Или (crmName(crmPayerName)<>crmName(crmPayer.ПолучитьАтрибут("NAME"))) Тогда
        Предупреждение("Заказчик заявки не совпал с плательщиком XML или помечен на удаление."); Возврат -1;
    КонецЕсли;
    crmAgreement=СоздатьОбъект("Справочник.Договоры"); crmAgreement.НайтиЭлемент(crmDoc.ДоговорПлательщика);
    Если (crmAgreement.Владелец<>crmDoc.Плательщик) Или (crmAgreement.ПометкаУдаления()=1) Или (crmAgreement.ОплатаДоговора<>1) Тогда
        Предупреждение("Основание плательщика не соответствует рублёвой заявке."); Возврат -1;
    КонецЕсли;
    Возврат crmApplication;
КонецФункции

Функция crmSettlementContext(crmRoot,crmID,crmPayer,crmApplication,crmCustomer,crmAgreement)
    crmContract=crmContractNode(crmRoot,crmID); Если crmError(crmContract)=1 Тогда Возврат 0; КонецЕсли;
    Если crmContract.ПолучитьАтрибут("KIND")="storno" Тогда
        crmNodeCustomer=crmContract.ВыбратьУзел("CUSTOMER");
        Если (crmPayer.ПолучитьАтрибут("ID")<>crmNodeCustomer.ПолучитьАтрибут("ID")) Или (crmName(crmPayer.ПолучитьАтрибут("NAME"))<>crmName(crmNodeCustomer.ПолучитьАтрибут("NAME"))) Тогда Предупреждение("Плательщик возврата отличается от заказчика."); Возврат 0; КонецЕсли;
        crmApplication="";
        Возврат crmReturnParties(crmContract,crmCustomer,crmAgreement);
    КонецЕсли;
    crmApplication=crmApplicationForPayment(crmRoot,crmID,crmPayer);
    Если crmError(crmApplication)=1 Тогда Возврат 0; КонецЕсли;
    crmDoc=СоздатьОбъект("Документ.Заявка"); crmDoc.НайтиДокумент(crmApplication);
    crmCustomer=crmDoc.Плательщик; crmAgreement=crmDoc.ДоговорПлательщика;
    Возврат 1;
КонецФункции


Функция crmValidatePayment(crmRoot,crmOperation,crmContractID,crmPaymentID,crmPayer,crmExpected,crmOffset)
    Если crmUUID(crmPaymentID)=0 Тогда Предупреждение("Некорректный ключ исходной оплаты."); Возврат 0; КонецЕсли;
    crmContract=crmContractNode(crmRoot,crmContractID);
    Если crmError(crmContract)=1 Тогда Возврат 0; КонецЕсли;
    crmPayment=crmPaymentNode(crmContract,crmPaymentID);
    Если crmError(crmPayment)=1 Тогда Возврат 0; КонецЕсли;
    Если (crmPayment.ПолучитьАтрибут("DATE")<>crmOperation.ПолучитьАтрибут("DATE")) Или (Число(crmPayment.ПолучитьАтрибут("AMOUNT"))<>crmExpected) Или (crmPayment.ПолучитьАтрибут("PAYER_ID")<>crmPayer.ПолучитьАтрибут("ID")) Или (crmName(crmPayment.ПолучитьАтрибут("PAYER_NAME"))<>crmName(crmPayer.ПолучитьАтрибут("NAME"))) Тогда
        Предупреждение("Сумма, дата или плательщик операции не совпали с исходной оплатой XML."); Возврат 0;
    КонецЕсли;
    crmMethod=crmPayment.ПолучитьАтрибут("METHOD");
    crmPaymentType=crmOperation.ПолучитьАтрибут("TYPE");
    Если (crmPaymentType="cash_receipt") Или (crmPaymentType="cash_refund") Тогда
        Если (crmMethod<>"Касса чек") Или (crmPayment.ПолучитьАтрибут("STATUS")<>"planned") Тогда
            Предупреждение("Для ПКО/РКО нужна разрешённая оплата Касса чек."); Возврат 0;
        КонецЕсли;
        Возврат 1;
    КонецЕсли;
    Если crmOffset=1 Тогда
        Если crmPayment.ПолучитьАтрибут("STATUS")<>"offset_proposed" Тогда Предупреждение("Пара зачёта не подтверждена планом выгрузки."); Возврат 0; КонецЕсли;
        Если (crmMethod<>"Зачет") И (crmMethod<>"Зачёт") Тогда Предупреждение("Исходная оплата не является зачётом."); Возврат 0; КонецЕсли;
    Иначе
        crmDebit="";
        Если (crmMethod="Тинькофф Интернет") Или (crmMethod="Uniteller АББ Интернет") Или (crmMethod="Терминал") Тогда crmDebit="57.1"; КонецЕсли;
        Если (crmMethod="СБП") Или (crmMethod="Тинькофф QR") Или (crmMethod="Сбербанк QR") Тогда crmDebit="57.2"; КонецЕсли;
        Если (ПустаяСтрока(crmDebit)=1) Или (crmDebit<>crmOperation.ПолучитьАтрибут("DEBIT")) Тогда
            Предупреждение("Способ оплаты не соответствует счёту карты/СБП."); Возврат 0;
        КонецЕсли;
        Если crmPayment.ПолучитьАтрибут("STATUS")<>"planned" Тогда Предупреждение("Исходная оплата не разрешена планом выгрузки."); Возврат 0; КонецЕсли;
    КонецЕсли;
    Возврат 1;
КонецФункции

Функция crmHasPaymentMarker(crmComment,crmID,crmSources)
    Если Найти(crmComment,"[CRM_OP:"+crmID+"]")>0 Тогда Возврат 1; КонецЕсли;
    Для crmN=0 По crmSources.КоличествоУзлов-1 Цикл
        crmSourceID=crmSources.ПолучитьУзел(crmN).ПолучитьАтрибут("ID");
        Если Найти(crmComment,"[CRM_PAYMENT:"+crmSourceID+"]")>0 Тогда Возврат 1; КонецЕсли;
    КонецЦикла;
    Возврат 0;
КонецФункции

Функция crmAlreadyImported(crmID,crmSources)
    // Вся история, включая изменённые даты. Кассовые документы ищем отдельно:
    // у непроведённого/помеченного ордера может не быть бухгалтерской операции.
    crmSearch=СоздатьОбъект("Операция"); crmSearch.ВыбратьОперации(); crmCount=0;
    Пока crmSearch.ПолучитьОперацию()=1 Цикл
        Если crmSearch.Документ.Вид()="Операция" Тогда
            Если crmHasPaymentMarker(crmSearch.Документ.Комментарий,crmID,crmSources)=1 Тогда
                crmCount=crmCount+1;
                Сообщить("CRM: оплата уже связана с "+Строка(crmSearch.Документ)+". Повторно не создаётся; существующая не изменяется.");
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Для crmKind=1 По 2 Цикл
        crmCashSearch=СоздатьОбъект("Документ."+?(crmKind=1,"ПриходныйОрдер","РасходныйОрдер"));
        crmCashSearch.ВыбратьДокументы();
        Пока crmCashSearch.ПолучитьДокумент()=1 Цикл
            crmMatch=crmHasPaymentMarker(crmCashSearch.Комментарий,crmID,crmSources);
            Если crmKind=1 Тогда
                Если СокрЛП(crmCashSearch.Идентификатор)=crmID Тогда crmMatch=1; КонецЕсли;
            КонецЕсли;
            Если crmMatch=1 Тогда
                crmCount=crmCount+1;
                Сообщить("CRM: оплата уже связана с "+Строка(crmCashSearch.ТекущийДокумент())+"; проведён: "+Строка(crmCashSearch.Проведен())+"; удалён: "+Строка(crmCashSearch.ПометкаУдаления())+". Новая не создаётся.");
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат crmCount;
КонецФункции

Функция crmSelectDebitAnalytics(crmAccount)
    crmValues=СоздатьОбъект("СписокЗначений");
    Для crmN=1 По crmAccount.КоличествоСубконто() Цикл
        crmKind=crmAccount.ВидСубконто(crmN);
        crmValue="";
        Если ВвестиЗначение(crmValue,"Счёт "+Строка(crmAccount)+": выберите "+Строка(crmKind),crmKind.ТипСубконто())=0 Тогда Возврат -1; КонецЕсли;
        Если ПустоеЗначение(crmValue)=1 Тогда Предупреждение("Не заполнена аналитика счёта оплаты."); Возврат -1; КонецЕсли;
        Если ТипЗначения(crmValue)=11 Тогда
            Если (crmValue.ПометкаУдаления()=1) Или (crmValue.ЭтоГруппа()=1) Тогда Предупреждение("Выберите действующий элемент аналитики."); Возврат -1; КонецЕсли;
        КонецЕсли;
        crmValues.ДобавитьЗначение(crmValue);
    КонецЦикла;
    Возврат crmValues;
КонецФункции

Функция crmCachedAnalytics(crmAccount,crmCache,crmKey)
    crmValues="";
    Попытка crmValues=crmCache.Получить(crmKey); Исключение crmValues=""; КонецПопытки;
    crmValid=0;
    Если ТипЗначенияСтр(crmValues)="СписокЗначений" Тогда
        Если crmValues.РазмерСписка()=crmAccount.КоличествоСубконто() Тогда
            crmValid=1;
            Для crmN=1 По crmValues.РазмерСписка() Цикл
                crmValue=crmValues.ПолучитьЗначение(crmN);
                Если ПустоеЗначение(crmValue)=1 Тогда crmValid=0; КонецЕсли;
                Если ТипЗначения(crmValue)=11 Тогда
                    Если (crmValue.ПометкаУдаления()=1) Или (crmValue.ЭтоГруппа()=1) Тогда crmValid=0; КонецЕсли;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
    КонецЕсли;
    Если crmValid=1 Тогда Возврат crmValues; КонецЕсли;
    crmValues=crmSelectDebitAnalytics(crmAccount);
    Если crmError(crmValues)=1 Тогда Возврат -1; КонецЕсли;
    crmCache.Установить(crmKey,crmValues);
    Возврат crmValues;
КонецФункции

Процедура crmImportCash(crmRoot,crmNode,crmSources,crmDate,crmAmount,crmBatch=0,crmResult="",crmBatchCache="")
    crmStage="Проверка кассовой оплаты";
    crmType=crmNode.ПолучитьАтрибут("TYPE"); crmReceipt=?(crmType="cash_receipt",1,0);
    crmID=crmNode.ПолучитьАтрибут("ID"); crmContractID=crmNode.ПолучитьАтрибут("CONTRACT");
    crmDebit=?(crmReceipt=1,"50.1","62.2"); crmCredit=?(crmReceipt=1,"62.2","50.1");
    Если (crmAmount<=0) Или (crmNode.ПолучитьАтрибут("DEBIT")<>crmDebit) Или (crmNode.ПолучитьАтрибут("CREDIT")<>crmCredit) Или (crmNode.ПолучитьАтрибут("STATUS")<>"requires_cash_analytics") Тогда
        crmStop("Не подтверждена схема кассового ордера."); Возврат;
    КонецЕсли;
    crmPayer=crmNode.ВыбратьУзел("PAYER");
    Если ПустоеЗначение(crmPayer)=1 Тогда crmStop("Не указан плательщик кассовой оплаты."); Возврат; КонецЕсли;
    crmSourceID=crmSources.ПолучитьУзел(0).ПолучитьАтрибут("ID");
    crmExpected=?(crmReceipt=1,crmAmount,-crmAmount);
    Если crmValidatePayment(crmRoot,crmNode,crmContractID,crmSourceID,crmPayer,crmExpected,0)=0 Тогда Возврат; КонецЕсли;
    crmApplication=""; crmCustomer=""; crmAgreement="";
    Если crmSettlementContext(crmRoot,crmContractID,crmPayer,crmApplication,crmCustomer,crmAgreement)=0 Тогда Возврат; КонецЕсли;
    Если crmAlreadyImported(crmID,crmSources)>0 Тогда crmResult="existing"; Возврат; КонецЕсли;
    crmCurrency=Рубль;
    Если ПустоеЗначение(crmApplication)=0 Тогда
        crmApp=СоздатьОбъект("Документ.Заявка"); crmApp.НайтиДокумент(crmApplication);
        Если (crmApp.Валюта<>Рубль) Или (crmApp.Курс<>1) Тогда crmStop("Нужна рублёвая заявка."); Возврат; КонецЕсли;
    КонецЕсли;
    Если crmAgreement.Комиссия<>1 Тогда crmStop("Для кассового возврата нужно комиссионное основание. Справочник автоматически не изменяется."); Возврат; КонецЕсли;
    crmCashAccount=СчетПоКоду("50.1"); crmClientAccount=СчетПоКоду("62.2");
    Если (ПустоеЗначение(crmCashAccount)=1) Или (ПустоеЗначение(crmClientAccount)=1) Тогда crmStop("Не найдены счета 50.1/62.2."); Возврат; КонецЕсли;
    Если (crmClientAccount.КоличествоСубконто()<2) Или (crmClientAccount.ВидСубконто(1)<>ВидыСубконто.Контрагенты) Или (crmClientAccount.ВидСубконто(2)<>ВидыСубконто.Договоры) Или (crmCashAccount.КоличествоСубконто()<>1) Тогда
        crmStop("Не совпала ожидаемая аналитика счетов кассы/клиента."); Возврат;
    КонецЕсли;
    crmStage="Выбор движения денежных средств кассы";
    Если crmBatch=1 Тогда
        // Поступление и возврат имеют разные движения денежных средств даже на50.1.
        crmAnalytics=crmCachedAnalytics(crmCashAccount,crmBatchCache,crmType);
    Иначе
        crmAnalytics=crmSelectDebitAnalytics(crmCashAccount);
    КонецЕсли;
    Если crmError(crmAnalytics)=1 Тогда crmResult="cancelled"; Возврат; КонецЕсли;
    crmMovement=crmAnalytics.ПолучитьЗначение(1);
    crmKind=?(crmReceipt=1,"ПриходныйОрдер","РасходныйОрдер");
    crmPrompt="Создать и провести один "+?(crmReceipt=1,"ПКО","РКО")+" в тестовой базе?"+РазделительСтрок;
    crmPrompt=crmPrompt+Формат(crmDate,"Д ДД.ММ.ГГГГ")+"; Дт "+crmDebit+" / Кт "+crmCredit+"; сумма "+Строка(crmAmount)+РазделительСтрок;
    crmPrompt=crmPrompt+Строка(crmApplication)+"; "+Строка(crmCustomer)+"; "+Строка(crmAgreement)+РазделительСтрок;
    crmPrompt=crmPrompt+"Движение денег: "+Строка(crmMovement)+РазделительСтрок+"Проверим штатные проводки: без повторного начисления выручки и налогового дохода.";
    Если crmBatch=0 Тогда
        Если Вопрос(crmPrompt,4)<>6 Тогда Возврат; КонецЕсли;
    КонецЕсли;
    НачатьТранзакцию(); crmTransaction=1;
    crmStage="Повторная проверка кассовой оплаты";
    Если crmAlreadyImported(crmID,crmSources)>0 Тогда crmResult="existing"; crmStop("Кассовая оплата уже существует."); Возврат; КонецЕсли;
    crmRechecked=""; crmCheckCustomer=""; crmCheckAgreement="";
    Если crmSettlementContext(crmRoot,crmContractID,crmPayer,crmRechecked,crmCheckCustomer,crmCheckAgreement)=0 Тогда crmStop("Не прошла повторная проверка возврата."); Возврат; КонецЕсли;
    Если (crmRechecked<>crmApplication) Или (crmCheckCustomer<>crmCustomer) Или (crmCheckAgreement<>crmAgreement) Или (crmAgreement.Комиссия<>1) Тогда crmStop("Основания кассового документа изменились."); Возврат; КонецЕсли;
    crmStage="Заполнение нового кассового ордера";
    crmCash=СоздатьОбъект("Документ."+crmKind); crmCash.Новый(); crmCash.ДатаДок=crmDate; crmCash.УстановитьНовыйНомер();
    crmCash.КоррСчет=crmClientAccount;
    Для crmN=1 По 3 Цикл crmCash.НазначитьТип("Субконто"+Строка(crmN),crmClientAccount.ВидСубконто(crmN)); КонецЦикла;
    crmCash.Субконто1=crmCustomer; crmCash.Субконто2=crmAgreement;
    crmCash.Сумма=crmAmount; crmCash.Валютный=1; crmCash.Валюта=crmCurrency; crmCash.КурсОплаты=1;
    crmCash.ФормироватьПроводки=1; crmCash.ДвижениеДенежныхСредств=crmMovement;
    // ДляНУ остаётся пустым: штатное комиссионное основание исключает повторный доход.
    // Возврат налогооблагаемого дохода здесь отдельно не придумываем.
    crmCash.Основание=?(crmReceipt=1,"Оплата по ","Возврат по ")+?(ПустоеЗначение(crmApplication)=1,"Основной договор",Строка(crmApplication));
    crmContract=crmContractNode(crmRoot,crmContractID);
    crmCash.Приложение="Договор CRM №"+crmContract.ПолучитьАтрибут("NUMBER");
    crmCash.Комментарий="[CRM_OP:"+crmID+"]"+РазделительСтрок+"[CRM_PAYMENT:"+crmSourceID+"]";
    Если crmReceipt=1 Тогда
        crmCash.ПринятоОт=crmPayer.ПолучитьАтрибут("NAME"); crmCash.Идентификатор=crmID;
        crmCash.ВерсияОбъекта=Константа.НомерРелиза; crmCash.РозничнаяВыручка=0;
    Иначе
        crmCash.Выдать=crmPayer.ПолучитьАтрибут("NAME");
    КонецЕсли;
    crmStage="Сохранение кассового ордера"; crmCash.Записать(); crmSaved=crmCash.ТекущийДокумент();
    crmStage="Штатное проведение кассового ордера"; crmCash.Провести(); crmCash.НайтиДокумент(crmSaved);
    Если (crmCash.Проведен()<>1) Или (crmCash.ПометкаУдаления()=1) Или (crmCash.Сумма<>crmAmount) Или (crmCash.ДатаДок<>crmDate) Или (crmCash.Субконто1<>crmCustomer) Или (crmCash.Субконто2<>crmAgreement) Или (crmHasPaymentMarker(crmCash.Комментарий,crmID,crmSources)<>1) Тогда
        crmStop("Не прошла проверка проведённого кассового ордера. Изменения отменены."); Возврат;
    КонецЕсли;
    crmStage="Проверка бухгалтерских проводок кассового ордера";
    crmVerify=СоздатьОбъект("Операция");
    Если crmVerify.НайтиОперацию(crmSaved)<>1 Тогда crmStop("Не найдена бухгалтерская операция ордера."); Возврат; КонецЕсли;
    crmVerify.ВыбратьПроводки(); crmTotal=0; crmCount=0;
    Пока crmVerify.ПолучитьПроводку()=1 Цикл
        crmCount=crmCount+1;
        Если (crmVerify.Дебет.Счет<>СчетПоКоду(crmDebit)) Или (crmVerify.Кредит.Счет<>СчетПоКоду(crmCredit)) Или (crmVerify.Сумма<=0) Тогда
            crmStop("Штатное проведение сформировало неожиданные проводки (включая возможный налоговый доход). Ордер отменён."); Возврат;
        КонецЕсли;
        Если crmReceipt=1 Тогда
            Если (crmVerify.Дебет.Субконто(1)<>crmMovement) Или (crmVerify.Кредит.Субконто(1)<>crmCustomer) Или (crmVerify.Кредит.Субконто(2)<>crmAgreement) Тогда crmStop("Не совпала аналитика ПКО."); Возврат; КонецЕсли;
        Иначе
            Если (crmVerify.Кредит.Субконто(1)<>crmMovement) Или (crmVerify.Дебет.Субконто(1)<>crmCustomer) Или (crmVerify.Дебет.Субконто(2)<>crmAgreement) Тогда crmStop("Не совпала аналитика РКО."); Возврат; КонецЕсли;
        КонецЕсли;
        crmTotal=crmTotal+crmVerify.Сумма;
    КонецЦикла;
    Если (crmCount=0) Или (crmTotal<>crmAmount) Тогда crmStop("Сумма проводок ордера не совпала с оплатой."); Возврат; КонецЕсли;
    ЗафиксироватьТранзакцию(); crmTransaction=0; crmResult="created";
    Сообщить("CRM: создан и проведён "+Строка(crmSaved)+"; Дт "+crmDebit+" / Кт "+crmCredit+"; сумма "+Строка(crmAmount));
    Сообщить("CRM: доход повторно не начислялся. Проверьте ордер и повторите эту оплату для проверки отсутствия дубля.");
    Если crmBatch=0 Тогда crmStage="Просмотр кассового ордера"; ОткрытьФорму(crmSaved); КонецЕсли;
КонецПроцедуры

Процедура crmImportPayment(crmBatch=0,crmBatchRoot="",crmBatchIndex=0,crmResult="",crmBatchCache="")
    crmResult="failed";
    Если crmBatch=1 Тогда
        crmRoot=crmBatchRoot;
    Иначе
        Если ЗагрузитьВнешнююКомпоненту("V7plus.dll")<>1 Тогда Предупреждение("Не найдена V7Plus.dll."); Возврат; КонецЕсли;
        crmXML=СоздатьОбъект("AddIn.XMLParser");
        Если Число(crmXML.ВерсияАнализатора)<2 Тогда Предупреждение("Нужен XMLParser не ниже 2.0."); Возврат; КонецЕсли;
        crmFile=""; crmDir="";
        Если ФС.ВыбратьФайл(0,crmFile,crmDir,"Выберите exchange.xml из CRM","Пакет CRM (*.xml)|*.xml","xml",)<>1 Тогда Возврат; КонецЕсли;
        crmStage="Чтение XML";
        crmXMLDoc=crmXML.СоздатьДокумент(); crmXMLDoc.Загрузить(crmDir+crmFile); crmRoot=crmXMLDoc.ЭлементДокумента;
    КонецЕсли;
    Если (crmRoot.Наименование<>"CRM_TEST_EXPORT") Или (crmRoot.ПолучитьАтрибут("VERSION")<>"1") Или (crmRoot.ПолучитьАтрибут("TEST_ONLY")<>"1") Или (crmRoot.ПолучитьАтрибут("YEAR")<>"2026") Тогда
        Предупреждение("Нужен тестовый пакет CRM версии 1 за 2026 год."); Возврат;
    КонецЕсли;
    crmContracts=crmRoot.ВыбратьУзлы("CONTRACT");
    Если crmContracts.КоличествоУзлов<1 Тогда Предупреждение("В пакете нет договоров."); Возврат; КонецЕсли;
    crmOperations=crmRoot.ВыбратьУзлы("OPERATIONS/OPERATION");
    Если crmOperations.КоличествоУзлов=0 Тогда Предупреждение("В пакете нет операций для загрузки."); Возврат; КонецЕсли;
    Если crmBatch=1 Тогда
        Если (crmBatchIndex<0) Или (crmBatchIndex>=crmOperations.КоличествоУзлов) Тогда Возврат; КонецЕсли;
        crmChoice=crmBatchIndex;
    Иначе
        crmList=СоздатьОбъект("СписокЗначений");
        Для crmN=0 По crmOperations.КоличествоУзлов-1 Цикл
            crmNode=crmOperations.ПолучитьУзел(crmN); crmType=crmNode.ПолучитьАтрибут("TYPE");
            Если (crmType="manual") Или (crmType="offset") Или (crmType="cash_receipt") Или (crmType="cash_refund") Тогда
                crmList.ДобавитьЗначение(crmN,crmNode.ПолучитьАтрибут("DATE")+": "+crmNode.ПолучитьАтрибут("AMOUNT")+"; Дт "+crmNode.ПолучитьАтрибут("DEBIT")+" / Кт "+crmNode.ПолучитьАтрибут("CREDIT")+"; "+crmType);
            Иначе
                Сообщить("CRM: неизвестный тип операции пропущен: "+crmType);
            КонецЕсли;
        КонецЦикла;
        Если crmList.РазмерСписка()=0 Тогда Предупреждение("В этом пакете нет поддерживаемых клиентских оплат."); Возврат; КонецЕсли;
        crmChoice=0; crmPosition=1;
        Если crmList.ВыбратьЗначение(crmChoice,"Выберите одну оплату для теста",crmPosition,,1)=0 Тогда Возврат; КонецЕсли;
    КонецЕсли;
    crmNode=crmOperations.ПолучитьУзел(crmChoice); crmID=crmNode.ПолучитьАтрибут("ID");
    Если crmUUID(crmID)=0 Тогда Предупреждение("Некорректный ключ операции."); Возврат; КонецЕсли;
    crmType=crmNode.ПолучитьАтрибут("TYPE"); crmOffset=?(crmType="offset",1,0);
    Если (crmType<>"manual") И (crmType<>"offset") И (crmType<>"cash_receipt") И (crmType<>"cash_refund") Тогда
        Предупреждение("Неизвестный тип операции не загружается."); Возврат;
    КонецЕсли;
    crmAmount=Число(crmNode.ПолучитьАтрибут("AMOUNT")); crmDebit=crmNode.ПолучитьАтрибут("DEBIT"); crmCredit=crmNode.ПолучитьАтрибут("CREDIT");
    crmDateText=crmNode.ПолучитьАтрибут("DATE");
    Если СтрДлина(crmDateText)<>10 Тогда Предупреждение("Некорректная дата оплаты."); Возврат; КонецЕсли;
    crmDate=Дата(Прав(crmDateText,2)+"."+Сред(crmDateText,6,2)+"."+Лев(crmDateText,4));
    Если (ДатаГод(crmDate)<>2026) Или (crmAmount=0) Или (Окр(crmAmount,2)<>crmAmount) Тогда Предупреждение("Некорректны год или сумма оплаты."); Возврат; КонецЕсли;
    crmSources=crmNode.ВыбратьУзлы("SOURCE_PAYMENT");
    Если crmSources.КоличествоУзлов<>1+crmOffset Тогда Предупреждение("Не совпало количество исходных оплат."); Возврат; КонецЕсли;
    Если (crmType="cash_receipt") Или (crmType="cash_refund") Тогда
        crmImportCash(crmRoot,crmNode,crmSources,crmDate,crmAmount,crmBatch,crmResult,crmBatchCache); Возврат;
    КонецЕсли;
    crmDebitApplication="";
    Если crmOffset=1 Тогда
        Если (crmDebit<>"62.2") Или (crmCredit<>"62.2") Или (crmAmount<=0) Или (crmNode.ПолучитьАтрибут("STATUS")<>"confirm_pair") Тогда Предупреждение("Не подтверждена схема зачёта 62.2 / 62.2."); Возврат; КонецЕсли;
        crmDebitID=crmNode.ПолучитьАтрибут("DEBIT_CONTRACT"); crmCreditID=crmNode.ПолучитьАтрибут("CREDIT_CONTRACT");
        Если crmDebitID=crmCreditID Тогда Предупреждение("Зачёт должен связывать разные договоры."); Возврат; КонецЕсли;
        crmDebitPayer=crmNode.ВыбратьУзел("DEBIT_PAYER"); crmCreditPayer=crmNode.ВыбратьУзел("CREDIT_PAYER");
        Если (ПустоеЗначение(crmDebitPayer)=1) Или (ПустоеЗначение(crmCreditPayer)=1) Тогда Предупреждение("Не заполнены обе стороны зачёта."); Возврат; КонецЕсли;
        crmSourceID=crmSources.ПолучитьУзел(0).ПолучитьАтрибут("ID"); crmTargetID=crmSources.ПолучитьУзел(1).ПолучитьАтрибут("ID");
        Если crmSourceID=crmTargetID Тогда Предупреждение("Совпали ключи сторон зачёта."); Возврат; КонецЕсли;
        Если crmValidatePayment(crmRoot,crmNode,crmDebitID,crmSourceID,crmDebitPayer,-crmAmount,1)=0 Тогда Возврат; КонецЕсли;
        Если crmValidatePayment(crmRoot,crmNode,crmCreditID,crmTargetID,crmCreditPayer,crmAmount,1)=0 Тогда Возврат; КонецЕсли;
        crmDebitApplication=""; crmDebitCustomer=""; crmDebitAgreement="";
        Если crmSettlementContext(crmRoot,crmDebitID,crmDebitPayer,crmDebitApplication,crmDebitCustomer,crmDebitAgreement)=0 Тогда Возврат; КонецЕсли;
    Иначе
        Если ((crmDebit<>"57.1") И (crmDebit<>"57.2")) Или (crmCredit<>"62.2") Или (crmNode.ПолучитьАтрибут("STATUS")<>"draft") Тогда Предупреждение("Не подтверждена схема оплаты карты/СБП."); Возврат; КонецЕсли;
        crmCreditID=crmNode.ПолучитьАтрибут("CONTRACT"); crmCreditPayer=crmNode.ВыбратьУзел("PAYER");
        Если ПустоеЗначение(crmCreditPayer)=1 Тогда Предупреждение("Не заполнен плательщик оплаты."); Возврат; КонецЕсли;
        crmSourceID=crmSources.ПолучитьУзел(0).ПолучитьАтрибут("ID");
        Если crmValidatePayment(crmRoot,crmNode,crmCreditID,crmSourceID,crmCreditPayer,crmAmount,0)=0 Тогда Возврат; КонецЕсли;
    КонецЕсли;
    crmCreditApplication=""; crmCreditCustomer=""; crmCreditAgreement="";
    Если crmSettlementContext(crmRoot,crmCreditID,crmCreditPayer,crmCreditApplication,crmCreditCustomer,crmCreditAgreement)=0 Тогда Возврат; КонецЕсли;
    crmStage="Проверка повторной загрузки";
    Если crmAlreadyImported(crmID,crmSources)>0 Тогда crmResult="existing"; Возврат; КонецЕсли;
    crmDebitAccount=СчетПоКоду(crmDebit); crmCreditAccount=СчетПоКоду(crmCredit);
    Если (ПустоеЗначение(crmDebitAccount)=1) Или (ПустоеЗначение(crmCreditAccount)=1) Тогда Предупреждение("Не найдены счета операции."); Возврат; КонецЕсли;
    Если (crmCreditAccount.КоличествоСубконто()<2) Или (crmCreditAccount.ВидСубконто(1)<>ВидыСубконто.Контрагенты) Или (crmCreditAccount.ВидСубконто(2)<>ВидыСубконто.Договоры) Тогда
        Предупреждение("Не совпала аналитика счёта 62.2: нужны Контрагенты и Договоры на первых двух позициях."); Возврат;
    КонецЕсли;
    crmAnalytics=СоздатьОбъект("СписокЗначений");
    Если crmOffset=0 Тогда
        crmStage="Аналитика карты/СБП";
        Если crmBatch=1 Тогда
            crmAnalytics=crmCachedAnalytics(crmDebitAccount,crmBatchCache,crmDebit);
        Иначе
            crmAnalytics=crmSelectDebitAnalytics(crmDebitAccount);
        КонецЕсли;
        Если crmError(crmAnalytics)=1 Тогда crmResult="cancelled"; Возврат; КонецЕсли;
    КонецЕсли;
    crmPrompt="Создать одну ручную операцию в тестовой базе?"+РазделительСтрок;
    crmPrompt=crmPrompt+crmDateText+"; Дт "+crmDebit+" / Кт "+crmCredit+"; сумма "+Строка(crmAmount)+РазделительСтрок;
    crmPrompt=crmPrompt+"Кредит: "+Строка(crmCreditApplication)+"; "+Строка(crmCreditCustomer)+"; "+Строка(crmCreditAgreement);
    Если crmOffset=1 Тогда
        crmPrompt=crmPrompt+РазделительСтрок+"Дебет (откуда зачёт): "+Строка(crmDebitApplication)+"; "+Строка(crmDebitCustomer)+"; "+Строка(crmDebitAgreement);
    Иначе
        Для crmN=1 По crmAnalytics.РазмерСписка() Цикл
            crmPrompt=crmPrompt+РазделительСтрок+"Дебет: "+Строка(crmAnalytics.ПолучитьЗначение(crmN));
        КонецЦикла;
    КонецЕсли;
    Если crmAmount<0 Тогда crmPrompt=crmPrompt+РазделительСтрок+"Это возврат: сумма с минусом, счета не меняются местами."; КонецЕсли;
    Если crmBatch=0 Тогда
        Если Вопрос(crmPrompt,4)<>6 Тогда Возврат; КонецЕсли;
    КонецЕсли;
    crmStage="Запись ручной операции";
    НачатьТранзакцию(); crmTransaction=1;
    Если crmAlreadyImported(crmID,crmSources)>0 Тогда crmResult="existing"; crmStop("Повторное создание отменено."); Возврат; КонецЕсли;
    crmCheckApplication=""; crmCheckCustomer=""; crmCheckAgreement="";
    Если crmSettlementContext(crmRoot,crmCreditID,crmCreditPayer,crmCheckApplication,crmCheckCustomer,crmCheckAgreement)=0 Тогда crmStop("Не прошла проверка основания операции."); Возврат; КонецЕсли;
    Если (crmCheckApplication<>crmCreditApplication) Или (crmCheckCustomer<>crmCreditCustomer) Или (crmCheckAgreement<>crmCreditAgreement) Тогда crmStop("Основание операции изменилось."); Возврат; КонецЕсли;
    Если crmOffset=1 Тогда
        Если crmSettlementContext(crmRoot,crmDebitID,crmDebitPayer,crmCheckApplication,crmCheckCustomer,crmCheckAgreement)=0 Тогда crmStop("Не прошла проверка источника зачёта."); Возврат; КонецЕсли;
        Если (crmCheckApplication<>crmDebitApplication) Или (crmCheckCustomer<>crmDebitCustomer) Или (crmCheckAgreement<>crmDebitAgreement) Тогда crmStop("Источник зачёта изменился."); Возврат; КонецЕсли;
    КонецЕсли;
    crmComment="[CRM_OP:"+crmID+"]";
    Для crmN=0 По crmSources.КоличествоУзлов-1 Цикл
        crmComment=crmComment+РазделительСтрок+"[CRM_PAYMENT:"+crmSources.ПолучитьУзел(crmN).ПолучитьАтрибут("ID")+"]";
    КонецЦикла;
    crmStage="Создание контекста новой операции";
    crmOp=СоздатьОбъект("Операция"); crmOp.Новая();
    crmStage="Дата новой операции"; crmOp.ДатаОперации=crmDate;
    crmStage="Номер новой операции"; crmOp.Документ.УстановитьНовыйНомер("");
    crmOperationNumber=crmOp.Документ.НомерДок;
    crmStage="Служебные метки новой операции"; crmOp.Документ.Комментарий=crmComment;
    crmOp.Содержание="CRM: "+?(crmOffset=1,"Зачёт",?(crmAmount<0,"Возврат","Оплата"))+"; "+?(ПустоеЗначение(crmCreditApplication)=1,"Основной договор",Строка(crmCreditApplication));
    crmStage="Заполнение новой проводки";
    crmOp.НоваяПроводка(); crmOp.Дебет.Счет=crmDebitAccount; crmOp.Кредит.Счет=crmCreditAccount;
    crmOp.Кредит.Субконто(1,crmCreditCustomer); crmOp.Кредит.Субконто(2,crmCreditAgreement);
    Если crmOffset=1 Тогда
        crmOp.Дебет.Субконто(1,crmDebitCustomer); crmOp.Дебет.Субконто(2,crmDebitAgreement);
    Иначе
        Для crmN=1 По crmAnalytics.РазмерСписка() Цикл crmOp.Дебет.Субконто(crmN,crmAnalytics.ПолучитьЗначение(crmN)); КонецЦикла;
    КонецЕсли;
    crmStage="Суммы новой операции";
    crmOp.Сумма=crmAmount; crmOp.СуммаОперации=crmAmount; crmOp.СодержаниеПроводки=crmOp.Содержание;
    crmStage="Сохранение новой операции"; crmOp.Записать();
    // Не сохраняем контекст Документ из объекта операции и не заменяем
    // владеющий им объект: перечитываем отдельный документ по номеру и дате.
    crmStage="Поиск записанного документа операции";
    crmStoredDoc=СоздатьОбъект("Документ.Операция");
    Если crmStoredDoc.НайтиПоНомеру(crmOperationNumber,crmDate)<>1 Тогда crmStop("Не найден записанный документ операции. Изменения отменены."); Возврат; КонецЕсли;
    crmSaved=crmStoredDoc.ТекущийДокумент();
    crmStage="Выбор записанной операции";
    crmVerify=СоздатьОбъект("Операция");
    Если crmVerify.НайтиОперацию(crmSaved)<>1 Тогда crmStop("Не выбрана записанная операция. Изменения отменены."); Возврат; КонецЕсли;
    crmStage="Проверка записанной проводки";
    crmVerify.ВыбратьПроводки();
    Если crmVerify.ПолучитьПроводку()<>1 Тогда crmStop("Не найдена записанная проводка. Изменения отменены."); Возврат; КонецЕсли;
    Если (crmVerify.КоличествоПроводок()<>1) Или (crmVerify.Дебет.Счет<>crmDebitAccount) Или (crmVerify.Кредит.Счет<>crmCreditAccount) Или (crmVerify.Сумма<>crmAmount) Или (crmVerify.Кредит.Субконто(1)<>crmCreditCustomer) Или (crmVerify.Кредит.Субконто(2)<>crmCreditAgreement) Или (Найти(crmVerify.Документ.Комментарий,"[CRM_OP:"+crmID+"]")=0) Тогда
        crmStop("Не прошла проверка записанной операции. Изменения отменены."); Возврат;
    КонецЕсли;
    Если crmOffset=1 Тогда
        Если (crmVerify.Дебет.Субконто(1)<>crmDebitCustomer) Или (crmVerify.Дебет.Субконто(2)<>crmDebitAgreement) Тогда crmStop("Не совпала аналитика источника зачёта."); Возврат; КонецЕсли;
    Иначе
        Для crmN=1 По crmAnalytics.РазмерСписка() Цикл
            Если crmVerify.Дебет.Субконто(crmN)<>crmAnalytics.ПолучитьЗначение(crmN) Тогда crmStop("Не совпала аналитика счёта карты/СБП."); Возврат; КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    ЗафиксироватьТранзакцию(); crmTransaction=0; crmResult="created";
    Сообщить("CRM: создана одна ручная операция "+Строка(crmSaved)+"; Дт "+crmDebit+" / Кт "+crmCredit+"; сумма "+Строка(crmAmount));
    Сообщить("CRM: проверьте счета, сумму, знак и основания расчётов. Повторите загрузку этой оплаты: вторая операция создаваться не должна.");
    Если crmBatch=0 Тогда crmStage="Просмотр операции"; ОткрытьФорму(crmSaved); КонецЕсли;
КонецПроцедуры

Процедура ПриОткрытии()
    crmTransaction=0; crmStage="Запуск";
    Попытка
        crmImportPayment();
    Исключение
        Если crmTransaction=1 Тогда ОтменитьТранзакцию(); crmTransaction=0; Сообщить("CRM: операция не сохранена, изменения транзакции отменены."); КонецЕсли;
        Предупреждение("Оплата CRM ("+crmStage+"): "+ОписаниеОшибки());
    КонецПопытки;
    СтатусВозврата(0);
КонецПроцедуры
