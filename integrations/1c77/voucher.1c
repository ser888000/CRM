// Первый тест путёвки: одна загруженная заявка, штатные проводки и списание БСО.
Перем Connection,тзТипыКонтрагентов,тзМенеджеры,НадписьИнф,ГруппаCRM;
Перем crmTransaction,crmStage;

Функция crmUUID(crmText)
    Если СтрДлина(crmText)<>36 Тогда Возврат 0; КонецЕсли;
    Для crmN=1 По 36 Цикл
        crmChar=Сред(crmText,crmN,1);
        Если (crmN=9) Или (crmN=14) Или (crmN=19) Или (crmN=24) Тогда
            Если crmChar<>"-" Тогда Возврат 0; КонецЕсли;
        Иначе
            Если Найти("0123456789abcdef",crmChar)=0 Тогда Возврат 0; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Возврат ?(crmText="00000000-0000-0000-0000-000000000000",0,1);
КонецФункции

Функция crmError(crmValue)
    Если ТипЗначенияСтр(crmValue)="Число" Тогда
        Возврат ?(crmValue=-1,1,0);
    КонецЕсли;
    Возврат 0;
КонецФункции

Функция crmExisting(crmID)
    crmSearch=СоздатьОбъект("Документ");
    crmSearch.ВыбратьПоЗначению(,,"Идентификатор",crmID);
    crmFound=""; crmCount=0;
    Пока crmSearch.ПолучитьДокумент()=1 Цикл
        Если crmSearch.Вид()="Заявка" Тогда
            Если СокрЛП(crmSearch.Идентификатор)=crmID Тогда
                crmCount=crmCount+1;
                crmFound=crmSearch.ТекущийДокумент();
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если crmCount>1 Тогда
        Предупреждение("Найдено несколько заявок с одним ключом CRM. Нужна ручная проверка.");
        Возврат -1;
    КонецЕсли;
    Возврат crmFound;
КонецФункции


Процедура crmStop(crmMessage)
    Если crmTransaction=1 Тогда
        ОтменитьТранзакцию(); crmTransaction=0;
        Сообщить("CRM: изменения заявки и путёвки отменены, бланк не списан.");
    КонецЕсли;
    Предупреждение(crmMessage);
КонецПроцедуры

Функция crmVoucherExists(crmApplication)
    crmSearch=СоздатьОбъект("Документ");
    crmSearch.ВыбратьПодчиненныеДокументы(,,crmApplication);
    crmCount=0;
    Пока crmSearch.ПолучитьДокумент()=1 Цикл
        Если crmSearch.Вид()="Путевка" Тогда
            crmCount=crmCount+1;
            Сообщить("CRM: для заявки уже есть "+Строка(crmSearch.ТекущийДокумент())+"; серия "+crmSearch.СерияПутевки+"; номер "+Строка(crmSearch.НомерПутевки)+"; проведена: "+Строка(crmSearch.Проведен())+"; пометка удаления: "+Строка(crmSearch.ПометкаУдаления()));
        КонецЕсли;
    КонецЦикла;
    Возврат crmCount;
КонецФункции

Функция crmSettingsKey()
    Возврат "AborigenCRM_BSO_V1_"+НРег(КаталогИБ());
КонецФункции

Функция crmValidSettings(crmSettings)
    Если ТипЗначенияСтр(crmSettings)<>"СписокЗначений" Тогда Возврат 0; КонецЕсли;
    Попытка
        crmBlankValue=crmSettings.Получить("blank");
        crmStoreValue=crmSettings.Получить("store");
        crmSeries=crmSettings.Получить("series");
        crmNext=crmSettings.Получить("next");
        Если (ТипЗначения(crmBlankValue)<>11) Или (ТипЗначения(crmStoreValue)<>11) Тогда Возврат 0; КонецЕсли;
        Если ТипЗначенияСтр(crmSeries)<>"Строка" Тогда Возврат 0; КонецЕсли;
        Если ТипЗначенияСтр(crmNext)<>"Число" Тогда Возврат 0; КонецЕсли;
        crmBlank=СоздатьОбъект("Справочник.БланкиСтрогойОтчетности");
        crmStore=СоздатьОбъект("Справочник.МестаХранения");
        crmBlank.НайтиЭлемент(crmBlankValue); crmStore.НайтиЭлемент(crmStoreValue);
        Если (crmBlank.Выбран()=0) Или (crmStore.Выбран()=0) Тогда Возврат 0; КонецЕсли;
        Если (crmBlank.ПометкаУдаления()=1) Или (crmStore.ПометкаУдаления()=1) Или (crmBlank.ЭтоГруппа()=1) Или (crmStore.ЭтоГруппа()=1) Тогда Возврат 0; КонецЕсли;
        Если crmBlank.СпособУчета<>2 Тогда Возврат 0; КонецЕсли;
        Если СтрДлина(crmSeries)<>crmBlank.ДлинаСерии Тогда Возврат 0; КонецЕсли;
        Если (crmNext<1) Или (Цел(crmNext)<>crmNext) Тогда Возврат 0; КонецЕсли;
        Если (crmBlank.ДлинаНомера<1) Или (crmBlank.ДлинаНомера>10) Тогда Возврат 0; КонецЕсли;
        crmLimit=1;
        Для crmN=1 По crmBlank.ДлинаНомера Цикл crmLimit=crmLimit*10; КонецЦикла;
        Если crmNext>=crmLimit Тогда Возврат 0; КонецЕсли;
    Исключение
        Возврат 0;
    КонецПопытки;
    Возврат 1;
КонецФункции

Функция crmCopySettings(crmSource)
    crmCopy=СоздатьОбъект("СписокЗначений");
    crmCopy.Установить("blank",crmSource.Получить("blank"));
    crmCopy.Установить("store",crmSource.Получить("store"));
    crmCopy.Установить("series",crmSource.Получить("series"));
    crmCopy.Установить("next",crmSource.Получить("next"));
    Возврат crmCopy;
КонецФункции

Функция crmGetSettings()
    crmSettings="";
    Попытка
        crmSettings=ВосстановитьЗначение(crmSettingsKey());
    Исключение
        crmSettings="";
    КонецПопытки;
    Если crmValidSettings(crmSettings)=1 Тогда
        crmSettings=crmCopySettings(crmSettings);
        crmSummary="Бланк: "+Строка(crmSettings.Получить("blank"))+РазделительСтрок;
        crmSummary=crmSummary+"Склад: "+Строка(crmSettings.Получить("store"))+РазделительСтрок;
        crmSummary=crmSummary+"Серия: "+crmSettings.Получить("series")+"; следующий номер: "+Строка(crmSettings.Получить("next"))+РазделительСтрок;
        crmAnswer=Вопрос(crmSummary+"Использовать настройки? Нет - изменить.","Да+Нет+Отмена");
        Если crmAnswer="Да" Тогда Возврат crmSettings; КонецЕсли;
        Если crmAnswer<>"Нет" Тогда Возврат -1; КонецЕсли;
    КонецЕсли;
    crmBlank=СоздатьОбъект("Справочник.БланкиСтрогойОтчетности");
    Если crmBlank.Выбрать("Выберите вид номерных бланков путёвок",)=0 Тогда Возврат -1; КонецЕсли;
    Если (crmBlank.ЭтоГруппа()=1) Или (crmBlank.ПометкаУдаления()=1) Или (crmBlank.СпособУчета<>2) Тогда
        Предупреждение("Нужен действующий вид бланков с номерным учётом."); Возврат -1;
    КонецЕсли;
    crmStore=СоздатьОбъект("Справочник.МестаХранения");
    Если crmStore.Выбрать("Выберите склад с оприходованными бланками",)=0 Тогда Возврат -1; КонецЕсли;
    Если (crmStore.ЭтоГруппа()=1) Или (crmStore.ПометкаУдаления()=1) Тогда
        Предупреждение("Выберите действующий склад."); Возврат -1;
    КонецЕсли;
    crmSeries="";
    Если crmBlank.ДлинаСерии>0 Тогда
        Если ВвестиСтроку(crmSeries,"Серия бланков",10)=0 Тогда Возврат -1; КонецЕсли;
    КонецЕсли;
    crmNext=1;
    Если ВвестиЧисло(crmNext,"Начальный номер из оприходованного диапазона",10,0)=0 Тогда Возврат -1; КонецЕсли;
    crmSettings=СоздатьОбъект("СписокЗначений");
    crmSettings.Установить("blank",crmBlank.ТекущийЭлемент());
    crmSettings.Установить("store",crmStore.ТекущийЭлемент());
    crmSettings.Установить("series",crmSeries);
    crmSettings.Установить("next",crmNext);
    Если crmValidSettings(crmSettings)=0 Тогда
        Предупреждение("Проверьте длину серии и допустимый начальный номер."); Возврат -1;
    КонецЕсли;
    СохранитьЗначение(crmSettingsKey(),crmSettings);
    crmCheck=ВосстановитьЗначение(crmSettingsKey());
    Если crmValidSettings(crmCheck)=0 Тогда
        Предупреждение("Не удалось сохранить настройки бланков."); Возврат -1;
    КонецЕсли;
    Возврат crmSettings;
КонецФункции

Функция crmNextNumber(crmSettings)
    // Сверка с базой восстанавливает счётчик после сбоя сохранения профиля.
    // Номер вида/серии не повторяем даже на другом складе.
    // Существующие непроведённые/помеченные путёвки тоже занимают свой номер.
    crmNext=crmSettings.Получить("next");
    crmBlank=crmSettings.Получить("blank");
    crmSeries=crmSettings.Получить("series");
    crmScan=СоздатьОбъект("Документ.Путевка");
    crmScan.ВыбратьДокументы();
    Пока crmScan.ПолучитьДокумент()=1 Цикл
        Если (crmScan.Бланк=crmBlank) И (crmScan.СерияПутевки=crmSeries) Тогда
            Если crmScan.НомерПутевки>=crmNext Тогда crmNext=crmScan.НомерПутевки+1; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Возврат crmNext;
КонецФункции

Процедура crmImportVoucher()
    Если ЗагрузитьВнешнююКомпоненту("V7plus.dll")<>1 Тогда
        Предупреждение("Не найдена V7Plus.dll."); Возврат;
    КонецЕсли;
    crmXML=СоздатьОбъект("AddIn.XMLParser");
    Если Число(crmXML.ВерсияАнализатора)<2 Тогда Предупреждение("Нужен XMLParser не ниже 2.0."); Возврат; КонецЕсли;
    crmFile=""; crmDir="";
    Если ФС.ВыбратьФайл(0,crmFile,crmDir,"Выберите exchange.xml из CRM","Пакет CRM (*.xml)|*.xml","xml",)<>1 Тогда Возврат; КонецЕсли;
    crmStage="Чтение XML";
    crmXMLDoc=crmXML.СоздатьДокумент(); crmXMLDoc.Загрузить(crmDir+crmFile);
    crmRoot=crmXMLDoc.ЭлементДокумента;
    Если crmRoot.Наименование<>"CRM_TEST_EXPORT" Тогда Предупреждение("Это не пакет CRM."); Возврат; КонецЕсли;
    Если (crmRoot.ПолучитьАтрибут("VERSION")<>"1") Или (crmRoot.ПолучитьАтрибут("TEST_ONLY")<>"1") Тогда
        Предупреждение("Версия пакета не поддерживается."); Возврат;
    КонецЕсли;
    crmNodes=crmRoot.ВыбратьУзлы("CONTRACT");
    Если (crmNodes.КоличествоУзлов<1) Или (crmNodes.КоличествоУзлов>20) Тогда Предупреждение("Выберите тестовый пакет до 20 договоров."); Возврат; КонецЕсли;
    crmList=СоздатьОбъект("СписокЗначений");
    Для crmN=0 По crmNodes.КоличествоУзлов-1 Цикл
        crmNode=crmNodes.ПолучитьУзел(crmN);
        crmList.ДобавитьЗначение(crmN,"Договор "+crmNode.ПолучитьАтрибут("NUMBER")+" от "+crmNode.ПолучитьАтрибут("DATE"));
    КонецЦикла;
    crmChoice=0; crmPosition=1;
    Если crmList.ВыбратьЗначение(crmChoice,"Выберите договор для первой путёвки",crmPosition,,1)=0 Тогда Возврат; КонецЕсли;
    crmNode=crmNodes.ПолучитьУзел(crmChoice); crmID=crmNode.ПолучитьАтрибут("ID");
    Если crmUUID(crmID)=0 Тогда Предупреждение("Некорректный ключ CRM."); Возврат; КонецЕсли;
    crmStage="Поиск загруженной заявки";
    crmApplication=crmExisting(crmID);
    Если crmError(crmApplication)=1 Тогда Возврат; КонецЕсли;
    Если ПустоеЗначение(crmApplication)=1 Тогда Предупреждение("Сначала загрузите заявку обработкой CRM_1C_Application."); Возврат; КонецЕсли;
    Если crmVoucherExists(crmApplication)>0 Тогда
        Сообщить("CRM: новая путёвка не создана. Существующие документы и номер бланка не изменены."); Возврат;
    КонецЕсли;
    crmApp=СоздатьОбъект("Документ.Заявка"); crmApp.НайтиДокумент(crmApplication);
    Если crmApp.ПометкаУдаления()=1 Тогда Предупреждение("Заявка помечена на удаление."); Возврат; КонецЕсли;
    crmAmount=Число(crmNode.ПолучитьАтрибут("AMOUNT")); crmCost=Число(crmNode.ПолучитьАтрибут("COST"));
    crmDateText=crmNode.ПолучитьАтрибут("VOUCHER_DATE");
    Если СтрДлина(crmDateText)<>10 Тогда Предупреждение("Не задана дата путёвки."); Возврат; КонецЕсли;
    crmDate=Дата(Прав(crmDateText,2)+"."+Сред(crmDateText,6,2)+"."+Лев(crmDateText,4));
    Если (ДатаГод(crmDate)<>2026) Или (crmApp.ДатаДок<>crmDate) Тогда Предупреждение("Первый тест требует дату заявки 2026 года."); Возврат; КонецЕсли;
    Если (crmAmount<=0) Или (crmCost<0) Или (crmApp.ИтогоСумма<>crmAmount) Или (crmApp.ИтогоСебестоимость<>crmCost) Или (crmNode.ПолучитьАтрибут("CURRENCY")<>"RUB") Тогда
        Предупреждение("Суммы заявки отличаются от пакета. Нужна сверка перед путёвкой."); Возврат;
    КонецЕсли;
    Если (crmApp.Валюта<>Рубль) Или (crmApp.Курс<>1) Или (crmApp.ШтрафОтОператора<>0) Или (crmApp.ШтрафПокупателя<>0) Тогда
        Предупреждение("Для первого теста нужна рублёвая заявка без штрафов."); Возврат;
    КонецЕсли;
    // В первой версии проверяем один полностью оплаченный случай без возвратов.
    crmPayments=crmNode.ВыбратьУзлы("PAYMENT"); crmPaid=0;
    Для crmN=0 По crmPayments.КоличествоУзлов-1 Цикл
        crmPayment=crmPayments.ПолучитьУзел(crmN);
        crmPaymentAmount=Число(crmPayment.ПолучитьАтрибут("AMOUNT"));
        Если (crmPaymentAmount<0) Или (crmPayment.ПолучитьАтрибут("METHOD")="Зачет") Или (crmPayment.ПолучитьАтрибут("METHOD")="Зачёт") Тогда
            Предупреждение("Для первого теста выберите договор без возвратов и зачётов."); Возврат;
        КонецЕсли;
        crmPaid=crmPaid+crmPaymentAmount;
    КонецЦикла;
    Если crmPaid<crmAmount Тогда Предупреждение("Для первого теста нужен полностью оплаченный договор по данным пакета."); Возврат; КонецЕсли;
    Если crmApp.КоличествоСтрок()<>1 Тогда Предупреждение("В заявке должна быть одна строка заказчика."); Возврат; КонецЕсли;
    crmApp.ВыбратьСтроки(); crmApp.ПолучитьСтроку();
    crmTourist=crmApp.Турист;
    Если (crmApp.Сумма<>crmAmount) Или (crmApp.Себестоимость<>crmCost) Или (crmApp.СуммаСкидки<>0) Или (ПустоеЗначение(crmTourist)=1) Тогда
        Предупреждение("Строка заявки отличается от сумм пакета."); Возврат;
    КонецЕсли;
    Если (ПустоеЗначение(crmApp.Тур)=1) Или (ПустоеЗначение(crmApp.ДоговорПлательщика)=1) Или (ПустоеЗначение(crmApp.ДоговорОператора)=1) Тогда
        Предупреждение("Не заполнены тур и договоры расчётов в заявке."); Возврат;
    КонецЕсли;
    Если crmApp.Проведен()=0 Тогда
        Если crmApp.Статус<>Перечисление.СтатусыЗаявок.Введена Тогда
            Предупреждение("Статус непроведённой заявки изменён вручную. Нужна проверка."); Возврат;
        КонецЕсли;
    Иначе
        Если (crmApp.Статус<>Перечисление.СтатусыЗаявок.Оплата) И (crmApp.Статус<>Перечисление.СтатусыЗаявок.Оплачена) Тогда
            Предупреждение("Для первого теста не подходит статус проведённой заявки."); Возврат;
        КонецЕсли;
    КонецЕсли;
    crmStage="Настройки номерных бланков";
    crmSettings=crmGetSettings();
    Если crmError(crmSettings)=1 Тогда Возврат; КонецЕсли;
    crmNext=crmNextNumber(crmSettings);
    crmSettings.Установить("next",crmNext);
    Если crmValidSettings(crmSettings)=0 Тогда Предупреждение("Номер вне допустимого диапазона вида бланка."); Возврат; КонецЕсли;
    crmPrompt="Создать и провести одну путёвку в тестовой базе?"+РазделительСтрок;
    crmPrompt=crmPrompt+Строка(crmApplication)+"; дата "+crmDateText+"; сумма "+Строка(crmAmount)+РазделительСтрок;
    crmPrompt=crmPrompt+"Бланк: "+Строка(crmSettings.Получить("blank"))+"; склад: "+Строка(crmSettings.Получить("store"))+РазделительСтрок;
    crmPrompt=crmPrompt+"Серия: "+crmSettings.Получить("series")+"; номер: "+Строка(crmNext)+РазделительСтрок;
    crmPrompt=crmPrompt+"Новая непроведённая заявка тоже будет проведена штатными средствами 1С.";
    Если Вопрос(crmPrompt,4)<>6 Тогда Возврат; КонецЕсли;
    crmStage="Начало сохранения";
    НачатьТранзакцию(); crmTransaction=1;
    Если crmVoucherExists(crmApplication)>0 Тогда crmStop("Путёвка уже существует, создание отменено."); Возврат; КонецЕсли;
    crmApp.НайтиДокумент(crmApplication);
    Если (crmApp.ПометкаУдаления()=1) Или (crmApp.ИтогоСумма<>crmAmount) Или (crmApp.ИтогоСебестоимость<>crmCost) Тогда crmStop("Заявка изменилась, создание отменено."); Возврат; КонецЕсли;
    Если crmNextNumber(crmSettings)<>crmNext Тогда crmStop("Номер бланка уже занят. Повторите запуск для пересчёта."); Возврат; КонецЕсли;
    crmStage="Проведение заявки";
    Если crmApp.Проведен()=0 Тогда
        crmApp.Статус=Перечисление.СтатусыЗаявок.Оплата;
        crmApp.Записать(); crmApp.Провести();
        Если crmApp.Проведен()<>1 Тогда crmStop("Не удалось провести заявку. Проверьте сообщения 1С."); Возврат; КонецЕсли;
    КонецЕсли;
    crmStage="Заполнение путёвки";
    crmVoucher=СоздатьОбъект("Документ.Путевка");
    crmVoucher.Новый(); crmVoucher.ДатаДок=crmDate; crmVoucher.УстановитьНовыйНомер();
    crmVoucher.Заявка=crmApplication; crmVoucher.Тур=crmApp.Тур;
    crmVoucher.Плательщик=crmApp.Плательщик; crmVoucher.Валюта=crmApp.Валюта; crmVoucher.Курс=crmApp.Курс;
    crmVoucher.ДатаНачала=crmApp.ДатаНачала; crmVoucher.ДатаКонца=crmApp.ДатаКонца;
    crmVoucher.Бланк=crmSettings.Получить("blank"); crmVoucher.Склад=crmSettings.Получить("store");
    crmVoucher.СерияПутевки=crmSettings.Получить("series"); crmVoucher.НомерПутевки=crmNext;
    crmVoucher.флСписанияБланка=1;
    crmVoucher.Сумма=crmAmount; crmVoucher.Оплачено=crmAmount; crmVoucher.УжеОплачено=0; crmVoucher.Штраф=0;
    crmVoucher.НоваяСтрока(); crmVoucher.Турист=crmTourist;
    crmVoucher.Стоимость=crmAmount; crmVoucher.Себестоимость=crmCost;
    crmStage="Списание бланка и проведение путёвки";
    crmVoucher.Записать(); crmVoucher.Провести();
    Если crmVoucher.Проведен()<>1 Тогда crmStop("Путёвка не проведена. Проверьте остаток бланков на дату путёвки и сообщения 1С."); Возврат; КонецЕсли;
    crmSaved=crmVoucher.ТекущийДокумент();
    crmCheck=СоздатьОбъект("Документ.Путевка"); crmCheck.НайтиДокумент(crmSaved);
    Если (crmCheck.Проведен()<>1) Или (crmCheck.Заявка<>crmApplication) Или (crmCheck.НомерПутевки<>crmNext) Или (crmCheck.Сумма<>crmAmount) Или (crmCheck.флСписанияБланка<>1) Тогда
        crmStop("Не прошла проверка сохранённой путёвки. Создание отменено."); Возврат;
    КонецЕсли;
    ЗафиксироватьТранзакцию(); crmTransaction=0;
    Сообщить("CRM: создана и проведена "+Строка(crmSaved)+" на основании "+Строка(crmApplication));
    Сообщить("CRM: списан один бланк; серия "+crmCheck.СерияПутевки+"; номер "+Строка(crmNext)+"; сумма "+Строка(crmAmount));
    crmStage="Сохранение следующего номера";
    Попытка
        crmSettings.Установить("next",crmNext+1);
        СохранитьЗначение(crmSettingsKey(),crmSettings);
    Исключение
        Сообщить("CRM: путёвка проведена, но следующий номер не сохранён в профиле. При следующем создании он будет восстановлен по документам базы.");
    КонецПопытки;
    Сообщить("CRM: отгрузка и клиентские платежи пока не создавались. Повторите тот же договор: новая путёвка и второе списание не должны появиться.");
    crmStage="Просмотр путёвки";
    ОткрытьФорму(crmSaved);
КонецПроцедуры

Процедура ПриОткрытии()
    crmTransaction=0; crmStage="Запуск";
    Попытка
        crmImportVoucher();
    Исключение
        Если crmTransaction=1 Тогда
            ОтменитьТранзакцию(); crmTransaction=0;
            Сообщить("CRM: изменения заявки и путёвки отменены, бланк не списан.");
        КонецЕсли;
        Предупреждение("Путёвка CRM ("+crmStage+"): "+ОписаниеОшибки());
    КонецПопытки;
    СтатусВозврата(0);
КонецПроцедуры
