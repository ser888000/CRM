// Авторский модуль проверки пакета CRM. Документы и проводки не создаёт.
Перем ТаблицаСчетов;

Процедура ПроверитьПакет()
    Если ЗагрузитьВнешнююКомпоненту("V7plus.dll")<>1 Тогда
        Предупреждение("Не найдена V7Plus.dll. Нужна компонента из установленной 1С.");
        Возврат;
    КонецЕсли;
    XML=СоздатьОбъект("AddIn.XMLParser");
    Если Число(XML.ВерсияАнализатора)<2 Тогда
        Предупреждение("Нужна версия XMLParser не ниже 2.0.");
        Возврат;
    КонецЕсли;
    ФС=СоздатьОбъект("ФС");
    Имя=""; Каталог="";
    Если ФС.ВыбратьФайл(0,Имя,Каталог,"Выберите exchange.xml из тестового пакета CRM","Пакет CRM (*.xml)|*.xml","xml",)<>1 Тогда
        Возврат;
    КонецЕсли;
    ДокXML=XML.СоздатьДокумент();
    ДокXML.Загрузить(Каталог+Имя);
    Корень=ДокXML.ЭлементДокумента;
    Если Корень.Наименование<>"CRM_TEST_EXPORT" Тогда
        Предупреждение("Это не тестовый пакет CRM."); Возврат;
    КонецЕсли;
    Если (Корень.ПолучитьАтрибут("VERSION")<>"1") Или (Корень.ПолучитьАтрибут("TEST_ONLY")<>"1") Тогда
        Предупреждение("Версия пакета не поддерживается."); Возврат;
    КонецЕсли;
    Договоры=Корень.ВыбратьУзлы("CONTRACT");
    Если (Договоры.КоличествоУзлов=0) Или (Договоры.КоличествоУзлов>20) Тогда
        Предупреждение("Для проверки нужно от 1 до 20 договоров."); Возврат;
    КонецЕсли;
    Сообщить("CRM: ПРОВЕРКА ЧТЕНИЯ. В базе 1С ничего не изменяется.");
    Сообщить("Год операций: "+Корень.ПолучитьАтрибут("YEAR"));
    Для Номер=0 По Договоры.КоличествоУзлов-1 Цикл
        Узел=Договоры.ПолучитьУзел(Номер);
        Сообщить("Договор "+Узел.ПолучитьАтрибут("NUMBER")+" от "+Узел.ПолучитьАтрибут("DATE"));
        Сообщить("Сумма: "+Узел.ПолучитьАтрибут("AMOUNT")+"; себестоимость: "+Узел.ПолучитьАтрибут("COST")+"; комиссия: "+Узел.ПолучитьАтрибут("COMMISSION"));
        Строки=Узел.ВыбратьУзлы("ROW");
        Если Строки.КоличествоУзлов<>1 Тогда
            Предупреждение("В договоре должна быть одна строка заказчика."); Возврат;
        КонецЕсли;
        Сообщить("Отгрузка: "+Узел.ПолучитьАтрибут("SHIPMENT_DATE")+"; проверка: "+Узел.ПолучитьАтрибут("SHIPMENT_STATUS"));
    КонецЦикла;
    Операции=Корень.ВыбратьУзлы("OPERATIONS/OPERATION");
    Для Номер=0 По Операции.КоличествоУзлов-1 Цикл
        Узел=Операции.ПолучитьУзел(Номер);
        Сообщить("Операция "+Узел.ПолучитьАтрибут("DATE")+": Дт "+Узел.ПолучитьАтрибут("DEBIT")+" / Кт "+Узел.ПолучитьАтрибут("CREDIT")+"; сумма "+Узел.ПолучитьАтрибут("AMOUNT")+"; "+Узел.ПолучитьАтрибут("STATUS"));
    КонецЦикла;
    Замечания=Корень.ВыбратьУзлы("ISSUES/ISSUE");
    Сообщить("Договоров: "+Строка(Договоры.КоличествоУзлов)+"; проектов операций: "+Строка(Операции.КоличествоУзлов)+"; замечаний: "+Строка(Замечания.КоличествоУзлов));
    Предупреждение("Чтение пакета завершено. Результат в окне сообщений. Документы НЕ загружены.");
КонецПроцедуры

Процедура ПриОткрытии()
    Попытка
        ПроверитьПакет();
    Исключение
        Предупреждение("Проверка CRM: "+ОписаниеОшибки());
    КонецПопытки;
    СтатусВозврата(0);
КонецПроцедуры
